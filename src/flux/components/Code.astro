---
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<pre class={cls} style="font-family:var(--font-mono);font-size:var(--text-sm);line-height:1.6;padding:var(--spacing-6);border-radius:var(--radius-xl);background:var(--flux-bg-base);border:1px solid var(--flux-glass-border);overflow-x:auto;"><slot /></pre>
