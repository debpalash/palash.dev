---
interface Props {
  brand?: string;
}
const { brand = 'palash.dev' } = Astro.props;
const year = new Date().getFullYear();
---

<footer style="margin-top:auto;padding:var(--spacing-16) 0 var(--spacing-8);text-align:center;">
  <div style="font-family:var(--font-mono);font-size:var(--text-sm);color:var(--flux-fg-muted);">
    {brand} <span style="color:var(--flux-fg-faint); margin-left:var(--spacing-1);">© {year}</span>
  </div>
  
  <div style="margin:var(--spacing-6) auto;max-width:180px;display:flex;align-items:center;gap:var(--spacing-4);">
    <div style="flex:1;height:1px;background:var(--flux-glass-border);"></div>
    <span style="font-size:var(--text-xs);color:var(--flux-fg-faint);letter-spacing:2px;">✦ ✧ ✦</span>
    <div style="flex:1;height:1px;background:var(--flux-glass-border);"></div>
  </div>

  <div style="display:flex;align-items:center;justify-content:center;gap:var(--spacing-6);">
    <slot />
  </div>
</footer>
