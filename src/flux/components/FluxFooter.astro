---
interface Props {
  brand?: string;
}
const { brand = 'palash.dev' } = Astro.props;
const year = new Date().getFullYear();
---

<footer style="border-top:1px solid var(--flux-glass-border);margin-top:var(--spacing-24);">
  <div style="max-width:72rem;margin:0 auto;padding:var(--spacing-10) var(--spacing-6);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:var(--spacing-4);">
    <div style="display:flex;align-items:center;gap:var(--spacing-4);">
      <span style="font-family:var(--font-display);font-weight:700;font-size:var(--text-sm);color:var(--flux-fg-muted);">
        {brand}
      </span>
      <span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--flux-fg-faint);">
        © {year}
      </span>
    </div>

    <div style="display:flex;align-items:center;gap:var(--spacing-4);">
      <slot />
    </div>
  </div>
</footer>
