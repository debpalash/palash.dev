---
interface Props {
  variant?: 'default' | 'success' | 'warning' | 'danger' | 'info';
  class?: string;
}
const { variant = 'default', class: cls = '' } = Astro.props;

const colors = {
  default: 'var(--flux-accent)',
  success: 'var(--flux-accent-success)',
  warning: 'var(--flux-accent-warm)',
  danger: 'var(--flux-accent-danger)',
  info: 'var(--flux-accent-cool)',
};

const c = colors[variant];
const style = `
  display:inline-flex;align-items:center;gap:var(--spacing-1_5);
  padding:var(--spacing-0_5) var(--spacing-3);
  border-radius:var(--radius-full);
  font-family:var(--font-mono);font-size:var(--text-xs);font-weight:600;
  letter-spacing:0.04em;text-transform:uppercase;
  color:${c};
  background:color-mix(in oklch, ${c}, transparent 85%);
  border:1px solid color-mix(in oklch, ${c}, transparent 65%);
`.replace(/\n/g, '');
---

<span style={style} class={cls}>
  <slot />
</span>
