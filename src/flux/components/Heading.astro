---
interface Props {
  level?: 1 | 2 | 3 | 4;
  marker?: string;
  class?: string;
}
const { level = 1, marker, class: cls = '' } = Astro.props;
const Tag = `h${level}` as any;

const sizes: Record<number, string> = {
  1: 'font-size:clamp(var(--text-4xl),6vw,var(--text-6xl));',
  2: 'font-size:clamp(var(--text-2xl),4vw,var(--text-4xl));',
  3: 'font-size:clamp(var(--text-xl),3vw,var(--text-2xl));',
  4: 'font-size:var(--text-lg);',
};

const baseStyle = `
  font-family:var(--font-display);font-weight:800;
  line-height:1.1;letter-spacing:-0.03em;
  color:var(--flux-fg-primary);
  ${sizes[level]}
`.replace(/\n/g, '');
---

<Tag style={baseStyle} class={cls}>
  {marker && <span style="color:var(--flux-fg-faint);font-weight:400;margin-right:var(--spacing-2);font-size:0.6em;opacity:0.5;">{marker}</span>}
  <slot />
</Tag>
