---
/**
 * Desktop shell — the "fun mode" at /os.
 *
 * Owns global.css (webtui, the 13 themes, windows, CRT) and the theme
 * roulette. The plain reading pages use Page.astro instead, so none of
 * that ships on /, /blog or the product pages.
 */
import '../styles/global.css';
import Head from '../components/Head.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const { title, description, ogImage = '/og-default.png', ogType = 'website' } = Astro.props;
---

<!doctype html>
<html lang="en" data-webtui-theme="dark" data-theme="shaktimaan">
  <head>
    <script
      is:inline
      set:html={`(function(){try{var T=${JSON.stringify(SITE.themes)};var t=sessionStorage.getItem('phosphor-theme');if(!t)t=T[Math.floor(Math.random()*T.length)];if(t==='phosphor')delete document.documentElement.dataset.theme;else document.documentElement.dataset.theme=t;}catch(e){}})();`}
    />
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      themeColor="#050805"
    />
    <slot name="head" />
  </head>
  <body class="os">
    <a href="#desktop" class="os-skip-link">Skip to Desktop</a>
    <slot />
  </body>
</html>
