---
import '../styles/site.css';
import { renderHead } from '../lib/head';
import type { PageData } from '../lib/page-data';
import { products } from '../lib/content';
import { SITE } from '../site.config';
import AppIcon from '../components/AppIcon.astro';
import Backdrop from '../components/Backdrop.astro';
import DesktopIcons from '../components/DesktopIcons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { page: PageData; status?: string }
const { page, status } = Astro.props;
const sections: Record<string, string> = { '/': 'Work', '/blog/': 'Writing', '/lab/': 'Lab', '/media/': 'Media', '/resume/': 'Résumé', '/contact/': 'Contact', '/search/': 'Search', '/preview/': 'Preview' };
const crumbs: [string, string][] = page.product ? [['/', 'Work'], [page.path, page.product.name]]
  : page.post ? [['/blog/', 'Writing'], [page.path, page.post.title]]
  : [[page.path, sections[page.path] ?? 'Finder']];
const appName = page.product ? page.product.name : page.post ? 'Writing' : sections[page.path] ?? 'Finder';
const windowTitle = page.path === '/' ? SITE.author : page.title.split(' — ')[0];
const productIndex = page.product ? products.findIndex(p => p.id === page.product!.id) : -1;
---
<!doctype html>
<html lang="en">
  <head><Fragment set:html={renderHead(page)} /></head>
  <body>
    <script is:inline>
      try { if (localStorage.getItem('zoomed') === '1') document.documentElement.classList.add('zoomed'); } catch {}
      // Must run before first paint: mark a Dock launch so the window grows out of the icon.
      addEventListener('pagereveal', function (e) {
        var launched = false;
        try { launched = sessionStorage.getItem('launch') === '1'; sessionStorage.removeItem('launch'); } catch {}
        if (launched && e.viewTransition && e.viewTransition.types) e.viewTransition.types.add('launch');
      });
    </script>
    <Backdrop />
    <Header page={page} appName={appName} />
    <div class="desktop">
      <DesktopIcons />
      <div class="window">
        <div class="titlebar">
          <div class="lights">
            <button class="light close" type="button" aria-label="Close window"><span aria-hidden="true">×</span></button>
            <button class="light minimize" type="button" aria-label="Minimize window"><span aria-hidden="true">−</span></button>
            <button class="light zoom" type="button" aria-label="Zoom window" aria-pressed="false"><span aria-hidden="true">+</span></button>
          </div>
          <div class="nav-buttons">
            <button type="button" data-history="back" aria-label="Back">◀</button>
            <button type="button" data-history="forward" aria-label="Forward">▶</button>
          </div>
          <div class={`window-title${productIndex >= 0 ? ` tone-${productIndex % 6}` : ''}`}>{page.product ? <AppIcon product={page.product} tone={productIndex} size={16} /> : <span class="proxy" aria-hidden="true"></span>}<span>{windowTitle}</span></div>
        </div>
        <div class="window-body">
          <aside class="sidebar">
            <nav aria-label="Products">
              <h2>Applications</h2>
              <ul>{products.map((product, i) => <li class={`tone-${i % 6} has-logo`}><a href={`/${product.id}/`} aria-current={page.product?.id === product.id ? 'page' : undefined}><AppIcon product={product} tone={i} size={20} />{product.name}</a></li>)}</ul>
            </nav>
            <nav aria-label="Elsewhere">
              <h2>Elsewhere</h2>
              <ul>
                <li class="has-logo"><a href={SITE.github} rel="me"><span class="mini-tile ic-github" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m8.5 7.5-4.5 4.5 4.5 4.5m7-9 4.5 4.5-4.5 4.5M13.5 5l-3 14" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>GitHub</a></li>
                <li class="has-logo"><a href={SITE.x} rel="me"><span class="mini-tile ic-x" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 5h3.2l8.8 14h-3.2ZM18 5l-5.2 6.2M6 19l5.2-6.2" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>X</a></li>
                <li class="has-logo"><a href="/rss.xml"><span class="mini-tile ic-rss" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="6.5" cy="17.5" r="2.2" fill="#fff"/><path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5M4.5 5a14.5 14.5 0 0 1 14.5 14.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg></span>RSS</a></li>
                <li class="has-logo"><a href="/llms.txt"><span class="mini-tile ic-doc" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.5 3.5h7.5l4 4v13h-11.5Z" fill="#fff"/><path d="M14 3.5v4h4" fill="#cfe3ff"/><path d="M9 11h6M9 14h6M9 17h4" stroke="#3a7fd8" stroke-width="1.5" stroke-linecap="round"/></svg></span>llms.txt</a></li>
              </ul>
            </nav>
          </aside>
          <main class="content" id="main" tabindex="-1"><slot /></main>
        </div>
        <div class="statusbar">
          <nav class="pathbar" aria-label="Path"><ol><li><a href="/"><span class="pb-disk" aria-hidden="true"></span>palash.dev</a></li>{crumbs.map(([href, label], i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{label}</span> : <a href={href}>{label}</a>}</li>)}</ol></nav>
          {status && <span class="status-text">{status}</span>}
        </div>
      </div>
    </div>
    <Footer page={page} />
  </body>
</html>

<script>
  // GitHub-style relative times; the build-time date stays as the fallback and tooltip.
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  const units: [Intl.RelativeTimeFormatUnit, number, string][] = [['year', 31536e6, 'y'], ['month', 2592e6, 'mo'], ['week', 6048e5, 'w'], ['day', 864e5, 'd'], ['hour', 36e5, 'h'], ['minute', 6e4, 'm']];
  const formatTimes = (scope: ParentNode = document) => {
    for (const time of scope.querySelectorAll<HTMLTimeElement>('time.ago')) {
      const diff = new Date(time.dateTime).getTime() - Date.now();
      const [unit, ms, short] = units.find(([, ms]) => Math.abs(diff) >= ms) ?? units[units.length - 1];
      const n = Math.round(diff / ms);
      time.title = new Date(time.dateTime).toLocaleString();
      time.textContent = time.classList.contains('short') ? `${Math.max(1, Math.abs(n))}${short}` : rtf.format(n, unit);
    }
  };
  formatTimes();

  // Live data: the edge Worker's GitHub snapshot refreshes numbers and releases baked in at build time.
  type Release = { tag: string; name: string; url: string; publishedAt: string; headline?: string; points?: string[] };
  type Live = { products: Record<string, { name: string; website: string | null; logoUrl: string | null; stars: number; downloads: number; release: Release | null }>; repos: { name: string; url: string; lang: string; stars: number; description: string }[] };
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`);
  const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n));
  // Scoped Astro styles key off a data-astro-cid attribute; copy it onto generated markup.
  const stamp = (host: Element) => {
    const cid = [...host.attributes].find(a => a.name.startsWith('data-astro-cid'));
    if (cid) for (const el of host.querySelectorAll('*')) el.setAttribute(cid.name, '');
  };
  const loadLive = async (): Promise<Live | null> => {
    try { const hit = JSON.parse(sessionStorage.getItem('live') ?? 'null'); if (hit && Date.now() - hit.at < 5 * 6e4) return hit.data; } catch {}
    try {
      const res = await fetch('/api/live.json', { signal: AbortSignal.timeout(8000) });
      if (!res.ok) return null;
      const data = await res.json() as Live;
      try { sessionStorage.setItem('live', JSON.stringify({ at: Date.now(), data })); } catch {}
      return data;
    } catch { return null; }
  };
  const applyLive = (live: Live) => {
    const products = Object.entries(live.products);
    for (const el of document.querySelectorAll<HTMLElement>('[data-live-stars]')) { const p = live.products[el.dataset.liveStars!]; if (p) el.textContent = p.stars.toLocaleString('en-US'); }
    for (const el of document.querySelectorAll<HTMLElement>('[data-live-downloads]')) { const p = live.products[el.dataset.liveDownloads!]; if (p) el.textContent = p.downloads.toLocaleString('en-US'); }
    for (const el of document.querySelectorAll<HTMLElement>('[data-live-total]')) {
      const total = el.dataset.liveTotal === 'stars'
        ? products.reduce((s, [, p]) => s + p.stars, 0) + live.repos.reduce((s, r) => s + r.stars, 0)
        : products.reduce((s, [, p]) => s + p.downloads, 0);
      el.textContent = compact(total);
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-live-release-inline]')) {
      const r = live.products[el.dataset.liveReleaseInline!]?.release;
      if (!r) continue;
      el.innerHTML = `<a href="${esc(r.url)}"><strong>${esc(r.tag)}</strong></a> · <time class="ago" datetime="${esc(r.publishedAt)}">${esc(r.publishedAt.slice(0, 10))}</time>`;
      stamp(el);
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-live-release]')) {
      const r = live.products[el.dataset.liveRelease!]?.release;
      if (!r) continue;
      el.innerHTML = `<a class="release" href="${esc(r.url)}" title="${esc(r.name)}"><span class="dot" aria-hidden="true"></span>${esc(r.tag)} · <time class="ago short" datetime="${esc(r.publishedAt)}">${esc(r.publishedAt.slice(0, 10))}</time></a>`;
      stamp(el);
    }
    const card = document.querySelector<HTMLElement>('[data-live-now]');
    const newest = products.filter(([, p]) => p.release).sort((a, b) => b[1].release!.publishedAt.localeCompare(a[1].release!.publishedAt))[0];
    if (card && newest && card.dataset.liveNow !== `${newest[0]}@${newest[1].release!.tag}`) {
      const [id, p] = newest; const r = p.release!;
      const title = r.name.replace(r.tag, '').replace(new RegExp(p.name.replace(/\.\w+$/, ''), 'i'), '').replace(/^[\s—–:|-]+|[\s—–:|-]+$/g, '').trim();
      const heading = title || r.headline || '';
      const points = (title && r.headline ? [r.headline, ...(r.points ?? [])] : r.points ?? []).slice(0, 3);
      card.innerHTML = `<h2 id="now-title">Now shipping</h2>
        <div class="rel-head">${p.logoUrl ? `<img class="app-logo rel-icon" src="${esc(p.logoUrl)}" alt="" width="34" height="34">` : ''}<div class="rel-id"><a class="rel-app" href="/${esc(id)}/">${esc(p.name)}</a><p class="rel-meta"><a class="rel-tag" href="${esc(r.url)}">${esc(r.tag)}</a><span class="badge">Latest</span><time class="ago" datetime="${esc(r.publishedAt)}">${esc(r.publishedAt.slice(0, 10))}</time></p></div></div>
        ${heading ? `<h3 class="rel-title">${esc(heading)}</h3>` : ''}
        ${points.length ? `<ul class="rel-points">${points.map(pt => `<li>${esc(pt)}</li>`).join('')}</ul>` : ''}
        <div class="buttons"><a class="button" href="${esc(r.url)}">Release Notes ↗</a>${p.website ? `<a class="button primary" href="${esc(p.website)}">Download ↗</a>` : ''}</div>`;
      card.dataset.liveNow = `${id}@${r.tag}`;
      stamp(card);
    }
    const lab = document.querySelector<HTMLElement>('[data-live-lab]');
    if (lab && live.repos.length) {
      // Keep curated descriptions already on the page; GitHub's fill in for new repos.
      const curated = new Map([...lab.querySelectorAll('li')].map(li => [li.querySelector('a')?.textContent ?? '', li.querySelector('.sub')?.textContent ?? '']));
      lab.innerHTML = live.repos.map(r => { const note = curated.get(r.name) || r.description; return `<li><a href="${esc(r.url)}">${esc(r.name)}</a><span class="when">${esc([r.lang, r.stars ? `★ ${r.stars}` : ''].filter(Boolean).join(' · ') || '—')}</span>${note ? `<span class="sub">${esc(note)}</span>` : ''}</li>`; }).join('');
      const count = document.querySelector('[data-live-lab-count]');
      if (count) count.textContent = String(live.repos.length);
    }
    formatTimes();
  };
  if (document.querySelector('[data-live-stars], [data-live-total], [data-live-release], [data-live-release-inline], [data-live-now], [data-live-lab]')) {
    window.setTimeout(async () => {
      const live = await loadLive();
      if (live) applyLive(live);
    }, 2000);
  }

  const root = document.documentElement;
  const win = document.querySelector<HTMLElement>('.window')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  // Genie: pinch the window toward a Dock icon (or back out of it).
  const genie = (target: Element, out: boolean) => {
    const from = win.getBoundingClientRect();
    const to = target.getBoundingClientRect();
    const dx = to.left + to.width / 2 - (from.left + from.width / 2);
    const dy = to.top + to.height / 2 - (from.top + from.height);
    const s = Math.max(to.width / from.width, .02);
    const frames: Keyframe[] = [
      { transform: 'none', clipPath: 'polygon(0 0, 100% 0, 100% 100%, 0 100%)', opacity: 1 },
      { offset: .45, transform: `translate(${dx * .15}px, ${dy * .35}px) scale(1, .9)`, clipPath: 'polygon(0 0, 100% 0, 62% 100%, 38% 100%)', opacity: 1 },
      { transform: `translate(${dx}px, ${dy}px) scale(${s})`, clipPath: 'polygon(40% 0, 60% 0, 52% 100%, 48% 100%)', opacity: .15 },
    ];
    win.style.transformOrigin = '50% 100%';
    return win.animate(out ? frames : [...frames].reverse(), { duration: still.matches ? 1 : 480, easing: 'cubic-bezier(.45, 0, .2, 1)', fill: 'forwards' });
  };
  const dockTarget = () => document.querySelector('.dock-item[data-running] .tile') ?? document.querySelector('.dock .tile')!;
  const minimize = document.querySelector<HTMLButtonElement>('.light.minimize')!;
  minimize.addEventListener('click', async () => {
    if (root.classList.contains('minimized')) return;
    const run = genie(dockTarget(), true);
    await run.finished;
    root.classList.add('minimized');
    run.cancel();
  });
  // Close: the window shrinks away; the app's Dock icon reopens it.
  document.querySelector<HTMLButtonElement>('.light.close')!.addEventListener('click', async () => {
    if (root.classList.contains('minimized')) return;
    const run = win.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(.94)' }], { duration: still.matches ? 1 : 200, easing: 'ease-in', fill: 'forwards' });
    await run.finished;
    root.classList.add('minimized', 'closed');
    run.cancel();
  });
  document.addEventListener('window:restore', async () => {
    const closed = root.classList.contains('closed');
    const run = closed
      ? win.animate([{ opacity: 0, transform: 'scale(.94)' }, { opacity: 1, transform: 'none' }], { duration: still.matches ? 1 : 260, easing: 'cubic-bezier(.2, .85, .25, 1)', fill: 'forwards' })
      : genie(dockTarget(), false);
    root.classList.remove('minimized', 'closed');
    await run.finished;
    run.cancel();
    document.getElementById('main')?.focus({ preventScroll: true });
  });
  const zoom = document.querySelector<HTMLButtonElement>('.light.zoom')!;
  const sync = () => zoom.setAttribute('aria-pressed', String(root.classList.contains('zoomed')));
  sync();
  zoom.addEventListener('click', () => {
    const on = root.classList.toggle('zoomed');
    try { localStorage.setItem('zoomed', on ? '1' : '0'); } catch {}
    sync();
  });
  document.querySelector('.titlebar')!.addEventListener('dblclick', e => { if (!(e.target as Element).closest('button')) zoom.click(); });
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-history]')) {
    button.addEventListener('click', () => {
      if (button.dataset.history === 'forward') history.forward();
      else if (history.length > 1 && document.referrer.startsWith(location.origin)) history.back();
      else location.href = '/';
    });
  }
</script>
