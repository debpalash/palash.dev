---
/**
 * Reading-mode shell: focused content + footer, no desktop chrome.
 *
 * Pairs with page.css. Deliberately loads none of global.css, the theme
 * roulette, or the window manager — those belong to OS.astro (/os).
 */
import '../styles/page.css';
import Head from '../components/Head.astro';
import Footer from '../components/page/Footer.astro';
import ModePull from '../components/profile/ModePull.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noIndex?: boolean;
  schemaType?: string | string[];
  mainEntityId?: string;
  breadcrumbId?: string;
  /** narrower measure for long-form reading (blog posts, product pages) */
  narrow?: boolean;
  /** wider measure with no top padding — the profile pages supply their own */
  wide?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  tags,
  noIndex = false,
  schemaType,
  mainEntityId,
  breadcrumbId,
  narrow = false,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noIndex={noIndex}
      themeColor="#080a0d"
      schemaType={schemaType}
      mainEntityId={mainEntityId}
      breadcrumbId={breadcrumbId}
    />
    <script is:inline>
      try {
        if (localStorage.getItem('palash-mode') === 'light') {
          document.documentElement.dataset.mode = 'light';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f2efe8');
        }
      } catch { /* storage can be disabled */ }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <ModePull />
    <main id="main" class:list={['shell', narrow && 'shell-narrow', wide && 'shell-wide']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
