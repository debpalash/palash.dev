---
import FluxLayout from '../../flux/components/FluxLayout.astro';
import Nav from '../../flux/components/Nav.astro';
import FluxFooter from '../../flux/components/FluxFooter.astro';
import Section from '../../flux/components/Section.astro';
import Heading from '../../flux/components/Heading.astro';
import Card from '../../flux/components/Card.astro';
import Badge from '../../flux/components/Badge.astro';
import Grid from '../../flux/components/Grid.astro';
import ThemeToggle from '../../flux/react/ThemeToggle';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order);

const statusVariant: Record<string, 'success' | 'info' | 'warning'> = {
  live: 'success',
  beta: 'info',
  'coming-soon': 'warning',
};
---

<FluxLayout title="Projects">
  <Nav>
    <ThemeToggle client:load slot="actions" />
  </Nav>

  <Section grain>
    <Heading level={1} marker="▸">Projects</Heading>

    <Grid cols={2} gap="var(--spacing-6)">
      {allProducts.map((p) => (
        <Card glow href={`/projects/${p.id}`}>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--spacing-3);">
            <h3 style="font-family:var(--font-display);font-size:var(--text-lg);font-weight:700;color:var(--flux-fg-primary);">{p.data.name}</h3>
            <Badge variant={statusVariant[p.data.status] || 'default'}>{p.data.status}</Badge>
          </div>
          <p style="font-size:var(--text-base);color:var(--flux-fg-secondary);margin-bottom:var(--spacing-3);line-height:1.6;">{p.data.tagline}</p>
          <div style="display:flex;flex-wrap:wrap;gap:var(--spacing-1_5);">
            {p.data.stack.map((t) => (
              <span style="font-family:var(--font-mono);font-size:var(--text-xs);padding:var(--spacing-0_5) var(--spacing-2);border-radius:var(--radius-md);background:var(--flux-bg-base);color:var(--flux-fg-muted);border:1px solid var(--flux-glass-border);">{t}</span>
            ))}
          </div>
        </Card>
      ))}
    </Grid>
  </Section>

  <FluxFooter />
</FluxLayout>
