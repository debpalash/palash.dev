---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import OS from '../layouts/OS.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const gallery = await getCollection('gallery');
  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      screenshots: gallery.filter((g) => g.data.group === product.id),
    },
  }));
}

const { product, screenshots } = Astro.props;
const { name, tagline, description, url, logoUrl, status, stack } = product.data;
---

<OS title={`${name} — ${tagline}`} description={description} mode="page">
  <div class="page-frame">
    <p class="dim">
      <a href={`/#prg-${product.id}`}>← run in PALASH.OS</a>
    </p>

    <article box-="double" class="mt-6 p-6">
      <div class="flex items-start gap-4 mb-4 flex-wrap">
        {logoUrl && (
          <Image
            src={logoUrl}
            alt={`${name} logo`}
            width={80}
            height={80}
            layout="fixed"
            style="border:1px solid var(--foreground2);background:var(--background1);"
          />
        )}
        <div>
          <h1 style="color:var(--foreground0);text-shadow:var(--glow);font-size:1.4rem;">
            {name}
          </h1>
          <p class="dim">{tagline}</p>
        </div>
      </div>

      <table divide-="none">
        <tbody>
          <tr>
            <td class="dim" style="padding-right:2ch;">STATUS</td>
            <td><span class={`dot ${status}`}>●</span> {status}</td>
          </tr>
          <tr>
            <td class="dim" style="padding-right:2ch;">STACK</td>
            <td>{stack.join(' · ')}</td>
          </tr>
          {url && (
            <tr>
              <td class="dim" style="padding-right:2ch;">SOURCE</td>
              <td><a href={url} target="_blank" rel="noopener">{url.replace('https://', '')} ↗</a></td>
            </tr>
          )}
        </tbody>
      </table>

      <p class="mt-4">{description}</p>

      {screenshots.length > 0 && (
        <div class="mt-6">
          <p class="dim mb-2">CAPTURES ({screenshots.length})</p>
          <div class="gallery-grid">
            {screenshots.map((s) => (
              <a
                class="gallery-item"
                href={s.data.src}
                target="_blank"
                rel="noopener"
                aria-label={`View ${s.data.title}`}
              >
                <Image
                  src={s.data.src}
                  alt={s.data.title}
                  width={360}
                  height={225}
                  layout="constrained"
                />
                <span class="cap">{s.data.caption}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="mt-6 flex gap-3 flex-wrap">
        {url && <a is-="button" href={url} target="_blank" rel="noopener">[ SOURCE ]</a>}
        <a is-="button" href="/">[ BACK TO OS ]</a>
      </p>
    </article>
  </div>
</OS>
