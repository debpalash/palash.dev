---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import GalleryStrip from '../components/page/GalleryStrip.astro';
import { SITE } from '../site.config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const gallery = await getCollection('gallery');
  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      screenshots: gallery.filter((g) => g.data.group === product.id),
    },
  }));
}

const { product, screenshots } = Astro.props;
const {
  name,
  tagline,
  description,
  url,
  website,
  github,
  stars,
  license,
  pricing,
  openSource,
  logoUrl,
  status,
  stack,
  category,
  os,
  keywords,
} =
  product.data;

const statusLabel =
  { live: 'live', beta: 'beta', 'coming-soon': 'coming soon' }[status] ?? status;
const formatStars = (count: number) =>
  count >= 1000 ? `${(count / 1000).toFixed(count >= 10000 ? 0 : 1)}k` : String(count);

const pageUrl = `${SITE.url}/${product.id}`;
const personId = `${SITE.url}/#person`;
const readmeUrl = github ? `${github.replace(/\/$/, '')}#readme` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name,
      ...(keywords.length ? { alternateName: keywords.slice(0, 3) } : {}),
      description,
      applicationCategory: category,
      operatingSystem: os,
      url: pageUrl,
      ...(logoUrl ? { image: logoUrl } : {}),
      ...((github ?? url) ? { codeRepository: github ?? url, downloadUrl: github ?? url } : {}),
      ...(readmeUrl ? { subjectOf: { '@type': 'CreativeWork', name: `${name} README`, url: readmeUrl } } : {}),
      sameAs: [github, SITE.x].filter(Boolean),
      author: { '@id': personId, '@type': 'Person', name: SITE.author, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.author, item: SITE.url },
        { '@type': 'ListItem', position: 2, name, item: pageUrl },
      ],
    },
  ],
};
---

<Page
  title={`${name} — ${tagline}`}
  description={description}
  ogImage={`/og/${product.id}.png`}
  narrow
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  </Fragment>

  <p style="margin-bottom:2rem;font-size:0.875rem;">
    <a href="/#work" class="muted">← work</a>
  </p>

  <article>
    <header class="product-head">
      {logoUrl && (
        <img
          class="product-logo"
          src={logoUrl}
          alt={`${name} logo`}
          width={56}
          height={56}
          loading="eager"
          decoding="async"
        />
      )}
      <div>
        <h1>{name}</h1>
        <p class="article-desc">{tagline}</p>
        <div class="article-meta">
          <span class:list={['status', `status-${status}`]}>{statusLabel}</span>
          {openSource && <span class="tag">open source</span>}
          {pricing && <span class="tag">{pricing}</span>}
          {license && <span class="tag">{license}</span>}
          {stars !== undefined && <span class="tag">★ {formatStars(stars)}</span>}
          {stack.map((s) => <span class="tag">{s}</span>)}
        </div>
        <nav class="product-links" aria-label={`${name} links`}>
          {website && <a href={website} target="_blank" rel="noopener">website ↗</a>}
          {(github ?? url) && <a href={github ?? url} target="_blank" rel="noopener">github ↗</a>}
          {readmeUrl && <a href={readmeUrl} target="_blank" rel="noopener">readme ↗</a>}
          <a href={SITE.x} target="_blank" rel="me noopener">x ↗</a>
        </nav>
      </div>
    </header>

    <div class="prose">
      <p>{description}</p>
    </div>

    <div class="btn-row">
      {(github ?? url) && (
        <a class="btn btn-primary" href={github ?? url} target="_blank" rel="noopener">
          View source ↗
        </a>
      )}
      <a class="btn" href={`/os#prg-${product.id}`}>Run in {SITE.osName}</a>
    </div>

    {screenshots.length > 0 && (
      <section class="section" style="margin-top:2.5rem;">
        <div class="section-head">
          <h2 class="section-title">Screenshots</h2>
          <span class="section-more muted">{screenshots.length}</span>
        </div>
        <GalleryStrip items={screenshots} />
      </section>
    )}
  </article>
</Page>
