---
import Site from '../layouts/Site.astro';
import Gallery from '../components/Gallery.astro';
import AppIcon from '../components/AppIcon.astro';
import { products, gallery, posts, latestRelease, type Product } from '../lib/content';
import { pageByPath } from '../lib/page-data';
export function getStaticPaths() { return products.map((product, index) => ({ params: { slug: product.id }, props: { product, index } })); }
interface Props { product: Product; index: number }
const { product: p, index } = Astro.props;
const shots = gallery.filter(s => s.group === p.id);
const related = posts.filter(post => post.tags.includes(p.id));
const release = latestRelease(p.id);
---
<Site page={pageByPath(`/${p.id}/`)} status={`${p.name} Info`}>
  <section class={`getinfo tone-${index % 6}`} aria-labelledby="product-title">
    <div class="main">
    <header>
      <AppIcon product={p} tone={index} size={72} class="hero-icon" />
      <div>
        <h1 id="product-title">{p.name}</h1>
        <p class="tagline">{p.tagline}</p>
      </div>
    </header>
    <p class="prose">{p.description}</p>
    <nav class="buttons" aria-label={`${p.name} links`}>
      {p.website && <a class="button primary" href={p.website}>Open ↗</a>}
      <a class={p.website ? 'button' : 'button primary'} href={p.github ?? p.url}>Source ↗</a>
      {p.github && <a class="button" href={`${p.github}/releases`}>Releases ↗</a>}
    </nav>
    </div>
    <aside class="inspector panel" aria-label={`${p.name} info`}>
    <dl class="info">
      <dt>Kind</dt><dd>{p.category.replace('Application', '').trim()} application</dd>
      <dt>Status</dt><dd>{p.status === 'coming-soon' ? 'Coming soon' : p.status.charAt(0).toUpperCase() + p.status.slice(1)}</dd>
      <dt>License</dt><dd>{p.license}</dd>
      <dt>Runs on</dt><dd>{p.os}</dd>
      {release && <><dt>Latest</dt><dd data-live-release-inline={p.id}><a href={release.url}>{release.tag}</a> · <time class="ago" datetime={release.publishedAt}>{release.publishedAt.slice(0, 10)}</time></dd></>}
      {p.stars ? <><dt>Stars</dt><dd data-live-stars={p.id}>{p.stars.toLocaleString('en-US')}</dd></> : null}
    </dl>
    <dl class="stats">{p.proof.map(item => <div><dt>{item.value}</dt><dd>{item.label}</dd></div>)}</dl>
    </aside>
  </section>
  {p.status === 'alpha' && p.id === 'bootable' && <aside class="alert"><p><strong>Writing erases the selected device.</strong> Check the target and keep backups.</p></aside>}
  <details class="section" open><summary><h2 id="stack">Stack</h2><span class="count">{p.stack.length}</span></summary><ul class="tokens">{p.stack.map(item => <li>{item}</li>)}</ul></details>
  {p.features.length > 0 && <details class="section" open><summary><h2>Capabilities</h2><span class="count">{p.features.length}</span></summary><div class="panel-grid">{p.features.map(f => <article class="panel"><h3>{f.title}</h3><p>{f.description}</p></article>)}</div></details>}
  {p.tables.map(t => <details class="section" open><summary><h2>{t.heading}</h2></summary>{t.lead && <p class="muted">{t.lead}</p>}<div class="table-scroll" tabindex="0" role="region" aria-label={`${t.heading} table`}><table><thead><tr>{t.columns.map(c => <th scope="col">{c}</th>)}</tr></thead><tbody>{t.rows.map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(c => <td>{c}</td>)}</tr>)}</tbody></table></div>{t.footnote && <p class="muted">{t.footnote}</p>}</details>)}
  {shots.length > 0 && <details class="section" open><summary><h2>Screenshots</h2><span class="count">{shots.length}</span></summary><Gallery shots={shots} /></details>}
  {related.length > 0 && <details class="section" open><summary><h2>Related writing</h2><span class="count">{related.length}</span></summary><div class="listview"><ul>{related.map(post => <li><a href={`/blog/${post.id}/`}>{post.title}</a><time class="when" datetime={post.publishDate.toISOString()}>{post.publishDate.toISOString().slice(0, 10)}</time></li>)}</ul></div></details>}
</Site>

<style>
  .getinfo header { display: flex; gap: 14px; align-items: center; margin-bottom: 12px; }
  .getinfo :global(.hero-icon) { width: 60px; height: 60px; }
  .getinfo { display: grid; gap: 4px 28px; margin-bottom: 14px; }
  .getinfo h1 { margin: 0; }
  .main > .prose { margin-bottom: 0; }
  .inspector { align-self: start; margin: 0; }
  .inspector .info { margin-top: 0; }
  .inspector .stats { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--hairline); }
  .inspector .stats div { flex: 1 1 0; }
  h1 { overflow-wrap: anywhere; }
  .tagline { margin: 2px 0 0; color: var(--text-2); }
  @media (min-width: 1100px) { .getinfo { grid-template-columns: minmax(0, 1fr) 300px; } }
  @media (min-width: 700px) {
    .getinfo :global(.hero-icon) { width: 72px; height: 72px; }
  }
</style>
