---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import GalleryStrip from '../components/page/GalleryStrip.astro';
import { SITE } from '../site.config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const gallery = await getCollection('gallery');
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      screenshots: gallery.filter((g) => g.data.group === product.id),
      relatedPosts: posts
        .filter((post) => post.data.tags.includes(product.id))
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
    },
  }));
}

const { product, screenshots, relatedPosts } = Astro.props;
const {
  name,
  alternateNames,
  tagline,
  description,
  audience,
  positioning,
  features,
  proof,
  updatedDate,
  url,
  website,
  github,
  stars,
  license,
  pricing,
  openSource,
  logoUrl,
  status,
  stack,
  category,
  os,
  keywords,
} =
  product.data;

const statusLabel =
  { live: 'live', beta: 'beta', 'coming-soon': 'coming soon' }[status] ?? status;
const formatStars = (count: number) =>
  count >= 1000 ? `${(count / 1000).toFixed(count >= 10000 ? 0 : 1)}k` : String(count);

const pageUrl = `${SITE.url}/${product.id}/`;
const personId = `${SITE.url}/#person`;
const readmeUrl = github ? `${github.replace(/\/$/, '')}#readme` : undefined;
const downloadUrl = github ? `${github.replace(/\/$/, '')}/releases` : url;
const breadcrumbId = `${pageUrl}#breadcrumb`;
const licenseUrl = license ? {
  'AGPL-3.0': 'https://spdx.org/licenses/AGPL-3.0-only.html',
  'GPL-3.0': 'https://spdx.org/licenses/GPL-3.0-only.html',
  MIT: 'https://spdx.org/licenses/MIT.html',
}[license] ?? license : undefined;
const seoTitle = {
  omnivoice: 'VoiceStudio.sh — Open-source AI voice studio',
  memxt: 'memXT — Local-first memory for AI agents',
  opal: 'Opal — AI media player for everything',
}[product.id] ?? `${name} — ${tagline}`;
const seoDescription = {
  omnivoice:
    'VoiceStudio.sh is an open-source ElevenLabs alternative for AI dubbing, voice cloning, and multilingual voice generation.',
  memxt:
    'memXT is local-first, open-source long-term memory for AI coding agents. Persistent context in one static binary, entirely on-device.',
  opal:
    'Opal is an AI media player for files, sites, servers, and feeds, built in Zig for macOS, Linux, and Windows.',
}[product.id] ?? description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name,
      ...(alternateNames.length ? { alternateName: alternateNames } : {}),
      description,
      applicationCategory: category,
      operatingSystem: os,
      url: pageUrl,
      mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
      ...(logoUrl ? { image: new URL(logoUrl, SITE.url).href } : {}),
      ...((github ?? url) ? { codeRepository: github ?? url } : {}),
      ...(downloadUrl ? { downloadUrl } : {}),
      ...(readmeUrl ? { subjectOf: { '@type': 'CreativeWork', name: `${name} README`, url: readmeUrl } } : {}),
      sameAs: [website, github].filter(Boolean),
      ...(features.length ? { featureList: features.map((feature) => feature.title) } : {}),
      ...(screenshots.length ? {
        screenshot: screenshots.slice(0, 6).map((shot) => ({
          '@type': 'ImageObject',
          name: shot.data.title,
          caption: shot.data.caption,
          contentUrl: shot.data.src,
        })),
      } : {}),
      author: { '@id': personId, '@type': 'Person', name: SITE.author, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url },
      offers: {
        '@type': 'Offer',
        price: pricing === 'paid' ? undefined : '0',
        priceCurrency: 'USD',
        availability: status === 'live'
          ? 'https://schema.org/InStock'
          : 'https://schema.org/PreOrder',
      },
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
      isAccessibleForFree: pricing === 'free',
      ...(licenseUrl ? { license: licenseUrl } : {}),
      ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.author, item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name, item: pageUrl },
      ],
    },
  ],
};
---

<Page
  title={seoTitle}
  description={seoDescription}
  ogImage={`/og/${product.id}.png`}
  mainEntityId={`${pageUrl}#app`}
  breadcrumbId={breadcrumbId}
  narrow
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <p class="back-link mono">
    <a href="/" class="muted">← Selected work</a>
  </p>

  <article>
    <header class="product-head">
      {logoUrl && (
        <img
          class="product-logo"
          src={logoUrl}
          alt={`${name} logo`}
          width={56}
          height={56}
          loading="eager"
          decoding="async"
        />
      )}
      <div>
        <h1>{name}</h1>
        <p class="article-desc">{tagline}</p>
        <div class="article-meta">
          <span class:list={['status', `status-${status}`]}>{statusLabel}</span>
          {openSource && <span class="tag">open source</span>}
          {pricing && <span class="tag">{pricing}</span>}
          {license && <span class="tag">{license}</span>}
          {stars !== undefined && <span class="tag">★ {formatStars(stars)}</span>}
          {stack.slice(0, 4).map((s) => <span class="tag">{s}</span>)}
        </div>
        <nav class="product-links" aria-label={`${name} links`}>
          {website && <a href={website} target="_blank" rel="noopener">website ↗</a>}
          {(github ?? url) && <a href={github ?? url} target="_blank" rel="noopener">github ↗</a>}
          {readmeUrl && <a href={readmeUrl} target="_blank" rel="noopener">readme ↗</a>}
          <a href={SITE.x} target="_blank" rel="me noopener">x ↗</a>
        </nav>
      </div>
    </header>

    <div class="btn-row product-cta-row">
      {(github ?? url) && (
        <a class="btn btn-primary" href={github ?? url} target="_blank" rel="noopener">
          Explore the Source ↗
        </a>
      )}
      <a class="btn" href={`/os#prg-${product.id}`}>Run in {SITE.osName}</a>
    </div>

    {proof.length > 0 && (
      <dl class="product-proof" aria-label={`${name} at a glance`}>
        {proof.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <section class="product-section product-thesis">
      <p class="product-eyebrow mono">The thesis</p>
      {positioning && <h2>{positioning}</h2>}
      <p>{description}</p>
      {audience && <p class="product-audience"><strong>Built for:</strong> {audience}</p>}
    </section>

    {features.length > 0 && (
      <section class="product-section">
        <p class="product-eyebrow mono">What it changes</p>
        <h2>Complex Machinery, Direct Experience</h2>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class="feature-card">
              <span class="feature-index mono" aria-hidden="true">0{index + 1}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {screenshots.length > 0 && (
      <section class="product-section product-gallery">
        <div class="section-head">
          <div>
            <p class="product-eyebrow mono">Inside the product</p>
            <h2>Screens, Not Claims</h2>
          </div>
          <span class="section-more mono muted">{screenshots.length} views</span>
        </div>
        <GalleryStrip items={screenshots} />
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="product-section related-notes">
        <p class="product-eyebrow mono">Field notes</p>
        <h2>The Thinking Behind {name}</h2>
        <div class="related-list">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.id}`}>
              <span>
                <strong>{post.data.title}</strong>
                <small>{post.data.description}</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <aside class="product-final-cta">
      <p class="product-eyebrow mono">Open by design</p>
      <h2>Inspect the Work. Run It. Change It.</h2>
      <p>{name} is built in public, with the source and engineering decisions open to scrutiny.</p>
      {(github ?? url) && (
        <a class="btn btn-primary" href={github ?? url} target="_blank" rel="noopener">
          Open {name} on GitHub ↗
        </a>
      )}
    </aside>
  </article>
</Page>
