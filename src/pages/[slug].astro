---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import { SITE } from '../site.config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const gallery = await getCollection('gallery');
  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      screenshots: gallery.filter((g) => g.data.group === product.id),
    },
  }));
}

const { product, screenshots } = Astro.props;
const { name, tagline, description, url, logoUrl, status, stack, category, os, keywords } =
  product.data;

const statusLabel =
  { live: 'live', beta: 'beta', 'coming-soon': 'coming soon' }[status] ?? status;

const pageUrl = `${SITE.url}/${product.id}`;
const personId = `${SITE.url}/#person`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name,
      ...(keywords.length ? { alternateName: keywords.slice(0, 3) } : {}),
      description,
      applicationCategory: category,
      operatingSystem: os,
      url: pageUrl,
      ...(logoUrl ? { image: logoUrl } : {}),
      ...(url ? { codeRepository: url, downloadUrl: url } : {}),
      author: { '@id': personId, '@type': 'Person', name: SITE.author, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.author, item: SITE.url },
        { '@type': 'ListItem', position: 2, name, item: pageUrl },
      ],
    },
  ],
};
---

<Page
  title={`${name} — ${tagline}`}
  description={description}
  ogImage={`/og/${product.id}.png`}
  narrow
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  </Fragment>

  <p style="margin-bottom:2rem;font-size:0.875rem;">
    <a href="/#work" class="muted">← work</a>
  </p>

  <article>
    <header class="product-head">
      {logoUrl && (
        <Image
          class="product-logo"
          src={logoUrl}
          alt={`${name} logo`}
          width={56}
          height={56}
          layout="fixed"
        />
      )}
      <div>
        <h1>{name}</h1>
        <p class="article-desc">{tagline}</p>
        <div class="article-meta">
          <span class:list={['status', `status-${status}`]}>{statusLabel}</span>
          {stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      </div>
    </header>

    <div class="prose">
      <p>{description}</p>
    </div>

    <div class="btn-row">
      {url && (
        <a class="btn btn-primary" href={url} target="_blank" rel="noopener">
          View source ↗
        </a>
      )}
      <a class="btn" href={`/os#prg-${product.id}`}>Run in {SITE.osName}</a>
    </div>

    {screenshots.length > 0 && (
      <section class="section" style="margin-top:2.5rem;">
        <div class="section-head">
          <h2 class="section-title">Screenshots</h2>
          <span class="section-more muted">{screenshots.length}</span>
        </div>
        <div class="gallery-strip">
          {screenshots.map((s) => (
            <a class="shot" href={s.data.src} target="_blank" rel="noopener">
              <Image
                src={s.data.src}
                alt={s.data.title}
                width={420}
                height={263}
                layout="constrained"
              />
              <span class="shot-cap">{s.data.caption}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Page>
