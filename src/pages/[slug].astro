---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import OS from '../layouts/OS.astro';
import { SITE } from '../site.config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const gallery = await getCollection('gallery');
  return products.map((product) => ({
    params: { slug: product.id },
    props: {
      product,
      screenshots: gallery.filter((g) => g.data.group === product.id),
    },
  }));
}

const { product, screenshots } = Astro.props;
const { name, tagline, description, url, logoUrl, status, stack, category, os, keywords } =
  product.data;

const pageUrl = `${SITE.url}/${product.id}`;
const personId = `${SITE.url}/#person`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name,
      ...(keywords.length ? { alternateName: keywords.slice(0, 3) } : {}),
      description,
      applicationCategory: category,
      operatingSystem: os,
      url: pageUrl,
      ...(logoUrl ? { image: logoUrl } : {}),
      ...(url ? { codeRepository: url, downloadUrl: url } : {}),
      author: { '@id': personId, '@type': 'Person', name: SITE.author, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.company.name, url: SITE.company.url },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.author, item: SITE.url },
        { '@type': 'ListItem', position: 2, name, item: pageUrl },
      ],
    },
  ],
};
---

<OS
  title={`${name} — ${tagline}`}
  description={description}
  ogImage={`/og/${product.id}.png`}
  mode="page"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  </Fragment>

  <div class="page-frame">
    <p class="dim">
      <a href={`/#prg-${product.id}`}>← run in PALASH.OS</a>
    </p>

    <article box-="double" class="mt-6 p-6">
      <div class="flex items-start gap-4 mb-4 flex-wrap">
        {logoUrl && (
          <Image
            src={logoUrl}
            alt={`${name} logo`}
            width={80}
            height={80}
            layout="fixed"
            style="border:1px solid var(--foreground2);background:var(--background1);"
          />
        )}
        <div>
          <h1 style="color:var(--foreground0);text-shadow:var(--glow);font-size:1.4rem;">
            {name}
          </h1>
          <p class="dim">{tagline}</p>
        </div>
      </div>

      <table divide-="none">
        <tbody>
          <tr>
            <td class="dim" style="padding-right:2ch;">STATUS</td>
            <td><span class={`dot ${status}`}>●</span> {status}</td>
          </tr>
          <tr>
            <td class="dim" style="padding-right:2ch;">STACK</td>
            <td>{stack.join(' · ')}</td>
          </tr>
          {url && (
            <tr>
              <td class="dim" style="padding-right:2ch;">SOURCE</td>
              <td><a href={url} target="_blank" rel="noopener">{url.replace('https://', '')} ↗</a></td>
            </tr>
          )}
        </tbody>
      </table>

      <p class="mt-4">{description}</p>

      {screenshots.length > 0 && (
        <div class="mt-6">
          <p class="dim mb-2">CAPTURES ({screenshots.length})</p>
          <div class="gallery-grid">
            {screenshots.map((s) => (
              <a
                class="gallery-item"
                href={s.data.src}
                target="_blank"
                rel="noopener"
                aria-label={`View ${s.data.title}`}
              >
                <Image
                  src={s.data.src}
                  alt={s.data.title}
                  width={360}
                  height={225}
                  layout="constrained"
                />
                <span class="cap">{s.data.caption}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="mt-6 flex gap-3 flex-wrap">
        {url && <a is-="button" href={url} target="_blank" rel="noopener">[ SOURCE ]</a>}
        <a is-="button" href="/">[ BACK TO OS ]</a>
      </p>
    </article>
  </div>
</OS>
