---
import Page from '../layouts/Page.astro';
---

<Page title="404 — page not found" description="That page doesn't exist.">
  <div class="notfound">
    <p class="notfound-code" aria-label="404">404</p>
    <h1 style="margin-top:1rem;">Page not found</h1>
    <p class="muted" style="margin-top:0.75rem;">
      This one was deleted, moved, or never shipped.
    </p>

    <div class="btn-row">
      <a class="btn btn-primary" href="/">Go home</a>
      <a class="btn" href="/blog">Read the log</a>
      <a class="btn" href="/os">Try the desktop ↗</a>
    </div>
  </div>
</Page>
