---
import FluxLayout from '../../flux/components/FluxLayout.astro';
import Nav from '../../flux/components/Nav.astro';
import FluxFooter from '../../flux/components/FluxFooter.astro';
import Section from '../../flux/components/Section.astro';
import Heading from '../../flux/components/Heading.astro';
import Card from '../../flux/components/Card.astro';
import Grid from '../../flux/components/Grid.astro';
import ThemeToggle from '../../flux/react/ThemeToggle';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<FluxLayout title="Blog">
  <Nav>
    <ThemeToggle client:load slot="actions" />
  </Nav>

  <Section>
    <Heading level={1} marker="▸">Blog</Heading>

    <nav style="display:flex;flex-wrap:wrap;gap:var(--spacing-2);margin:var(--spacing-6) 0;" aria-label="Tags">
      <a href="/blog" style="font-family:var(--font-mono);font-size:var(--text-xs);padding:var(--spacing-1) var(--spacing-3);border-radius:var(--radius-full);background:var(--flux-accent);color:var(--flux-bg-void);text-decoration:none;font-weight:600;">All</a>
      {allTags.map((tag) => (
        <a href={`/blog?tag=${tag}`} style="font-family:var(--font-mono);font-size:var(--text-xs);padding:var(--spacing-1) var(--spacing-3);border-radius:var(--radius-full);background:var(--flux-bg-base);color:var(--flux-fg-muted);border:1px solid var(--flux-glass-border);text-decoration:none;">{tag}</a>
      ))}
    </nav>

    <Grid cols={2} gap="var(--spacing-4)">
      {allPosts.map((post) => (
        <Card glow href={`/blog/${post.id}`}>
          <div style="display:flex;gap:var(--spacing-2);margin-bottom:var(--spacing-2);">
            {post.data.tags.slice(0, 2).map((tag) => (
              <span style="font-family:var(--font-mono);font-size:var(--text-xs);color:var(--flux-accent);text-transform:uppercase;letter-spacing:0.05em;">{tag}</span>
            ))}
          </div>
          <h3 style="font-family:var(--font-display);font-size:var(--text-md);font-weight:700;color:var(--flux-fg-primary);margin-bottom:var(--spacing-1);">{post.data.title}</h3>
          <p style="font-size:var(--text-sm);color:var(--flux-fg-muted);line-height:1.5;">{post.data.description}</p>
          <time style="display:block;margin-top:var(--spacing-2);font-family:var(--font-mono);font-size:var(--text-xs);color:var(--flux-fg-faint);">{formatDate(post.data.publishDate)}</time>
        </Card>
      ))}
    </Grid>
  </Section>

  <FluxFooter />
</FluxLayout>
