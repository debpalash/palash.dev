---
import { getCollection } from 'astro:content';
import OS from '../../layouts/OS.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<OS title="Docs — Blog Archive" mode="page">
  <div class="page-frame">
    <p class="dim">
      <a href="/#docs">← back to PALASH.OS</a>
    </p>

    <div box-="double" shear-="top" class="mt-6 p-4">
      <span class="dim">┤</span> <strong>~/docs — archive</strong> <span class="dim">├</span>

      <p class="dim mt-2 mb-4">total {allPosts.length} · <a href="/rss.xml">rss.xml</a></p>

      {allPosts.map((post) => (
        <a class="filerow" href={`/blog/${post.id}`}>
          <span class="fname">{post.id}.md</span>
          <span class="fmeta">{post.data.publishDate.toISOString().split('T')[0]}</span>
          <span class="fmeta">{post.data.description}</span>
        </a>
      ))}
    </div>
  </div>
</OS>
