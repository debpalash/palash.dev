---
import Site from '../layouts/Site.astro';
import Project from '../components/Project.astro';
import AppIcon from '../components/AppIcon.astro';
import Authorship from '../components/Authorship.astro';
import { products, posts, releases, totalStars, totalDownloads, featuredProduct as feat, latestRelease } from '../lib/content';
import { pageByPath } from '../lib/page-data';
import { SITE } from '../site.config';
const compact = (n: number) => n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
const featRelease = latestRelease(feat.id);
const now = releases[0];
const featIndex = products.findIndex(p => p.id === feat.id);
---
<Site page={pageByPath('/')} status={`${products.length} applications, ${posts.length} articles`}>
  <div class="home">
    <div class="main-col">
      <section class="about" aria-labelledby="home-title">
        <img class="avatar" src="/avatar.webp" alt="" width="72" height="72" />
        <div>
          <h1 id="home-title">Palash Debnath</h1>
          <p class="role">Founder, <a href={SITE.company.url}>{SITE.company.name}</a></p>
          <p class="bio">Agentic Software Designer from Agartala <span role="img" aria-label="India flag">🇮🇳</span> India building for the world.</p>
          <div class="buttons"><a class="button primary" href="/contact/">Get in Touch</a><a class="button" href="/resume/">Résumé</a><a class="button" href={SITE.github} rel="me">GitHub ↗</a></div>
        </div>
      </section>

      <dl class="stats">
        <div><dt data-live-total="stars">{compact(totalStars)}</dt><dd>GitHub stars</dd></div>
        <div><dt data-live-total="downloads">{compact(totalDownloads)}</dt><dd>Downloads</dd></div>
        <div><dt>{products.length}</dt><dd>Apps shipped</dd></div>
      </dl>

      <section class={`featured tone-${featIndex % 6}`} aria-labelledby="featured-title">
        <a class="shot" href={`/${feat.id}/`} tabindex="-1" aria-hidden="true">{(feat.homeImage ?? feat.workImage) && <img
          src={feat.homeImage ?? feat.workImage}
          srcset={feat.homeImageSmall ? `${feat.homeImageSmall} 675w, ${feat.homeImage ?? feat.workImage} 1350w` : undefined}
          sizes={feat.homeImageSmall ? '(min-width: 860px) 45vw, calc(100vw - 32px)' : undefined}
          alt="" width="1350" height="900" loading="eager" decoding="async" fetchpriority="high"
        />}</a>
        <div class="featured-copy">
          <p class="kicker">Featured application</p>
          <h2 id="featured-title"><AppIcon product={feat} tone={featIndex} size={28} class="feat-icon" /><a href={`/${feat.id}/`}>{feat.name}</a></h2>
          <p class="feat-tagline">{feat.tagline}</p>
          <ul class="feat-facts">
            {feat.stars ? <li><strong data-live-stars={feat.id}>{feat.stars.toLocaleString('en-US')}</strong> stars</li> : null}
            {feat.downloads ? <li><strong data-live-downloads={feat.id}>{feat.downloads.toLocaleString('en-US')}</strong> downloads</li> : null}
            {featRelease && <li data-live-release-inline={feat.id}><a href={featRelease.url}><strong>{featRelease.tag}</strong></a> · <time class="ago" datetime={featRelease.publishedAt}>{featRelease.publishedAt.slice(0, 10)}</time></li>}
          </ul>
          <div class="buttons">{feat.website && <a class="button primary" href={feat.website}>Download ↗</a>}<a class="button" href={`/${feat.id}/`}>Get Info</a></div>
        </div>
      </section>

      <section aria-labelledby="work"><h2 id="work">Applications</h2>
        <ul class="icon-view">{products.map((product, i) => <Project product={product} tone={i} />)}</ul>
      </section>
    </div>

    <aside class="side-col" aria-label="Recent activity">
      {now && <section class="now panel" aria-labelledby="now-title" data-live-now={`${now.product.id}@${now.tag}`}>
        <h2 id="now-title">Now shipping</h2>
        <div class="rel-head">
          <AppIcon product={now.product} tone={products.findIndex(p => p.id === now.product.id)} size={34} class="rel-icon" />
          <div class="rel-id">
            <a class="rel-app" href={`/${now.product.id}/`}>{now.product.name}</a>
            <p class="rel-meta"><a class="rel-tag" href={now.url}>{now.tag}</a><span class="badge">Latest</span><time class="ago" datetime={now.publishedAt}>{now.publishedAt.slice(0, 10)}</time></p>
          </div>
        </div>
        {now.cardTitle && <h3 class="rel-title">{now.cardTitle}</h3>}
        {now.cardPoints.length > 0 && <ul class="rel-points">{now.cardPoints.map(point => <li>{point}</li>)}</ul>}
        <div class="buttons"><a class="button" href={now.url}>Release Notes ↗</a>{now.product.website && <a class="button primary" href={now.product.website}>Download ↗</a>}</div>
      </section>}
      <section aria-labelledby="writing"><h2 id="writing">Recent writing</h2>
        <div class="listview">
          <div class="listview-head" aria-hidden="true"><span>Name</span><span>Date</span></div>
          <ol>{posts.slice(0, 5).map(p => <li><a href={`/blog/${p.id}/`}>{p.title}</a><time class="when" datetime={p.publishDate.toISOString()}>{p.publishDate.toISOString().slice(0, 10)}</time><span class="sub"><strong>{p.readMinutes} min</strong> <Authorship value={p.authorship} /></span></li>)}</ol>
        </div>
        <a class="button" href="/blog/">All articles</a>
      </section>
    </aside>
  </div>
</Site>

<style>
  .content > .home { max-width: 1120px; }
  .home { display: grid; gap: 8px 28px; }
  .main-col { container: main / inline-size; min-width: 0; }
  @container content (min-width: 860px) { .home { grid-template-columns: minmax(0, 1fr) 300px; } .side-col { padding-top: 6px; } .side-col > section:first-child h2 { margin-top: 0; } }

  .about { display: flex; gap: 14px; align-items: flex-start; }
  .avatar { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 12px; box-shadow: 0 2px 6px rgba(0, 0, 0, .25), 0 0 0 .5px rgba(0, 0, 0, .3); }
  h1 { margin: 0 0 2px; font: 200 clamp(1.9rem, 4.6vw, 2.8rem)/1.05 var(--font-display); letter-spacing: -.025em; }
  .role { margin: 0 0 6px; color: var(--text-3); font-size: .875rem; }
  .bio { margin: 0 0 6px; color: var(--text-2); font-size: .875rem; line-height: 1.5; }
  .now .dot { flex: 0 0 auto; align-self: flex-start; margin-top: .45em; width: 7px; height: 7px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #b6f0a8, #2f9a3a); box-shadow: 0 0 6px rgba(80, 200, 90, .7); }
  .about .buttons { margin-bottom: 0; }

  .featured { display: grid; margin: 18px 0 6px; overflow: hidden; background: var(--panel-bg); border: 1px solid var(--hairline); border-radius: 10px; box-shadow: var(--shadow-soft); }
  .shot { display: block; overflow: hidden; background: #111; border-bottom: 1px solid var(--hairline); }
  .shot img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; transition: transform .4s ease; }
  .featured:hover .shot img { transform: scale(1.02); }
  .featured-copy { padding: 12px 16px 14px; }
  .featured-copy .kicker { margin-bottom: 2px; }
  .featured h2 { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--text); font: 700 1.15rem/1.3 var(--font-ui); letter-spacing: 0; text-transform: none; }
  .featured h2 a { color: inherit; }
  .featured :global(.feat-icon) { width: 28px; height: 28px; }
  .feat-tagline { margin: 2px 0 8px; color: var(--text-2); }
  .feat-facts { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; padding: 0; color: var(--text-3); font-size: .75rem; list-style: none; }
  .feat-facts strong { color: var(--text); }
  .featured .buttons { margin-bottom: 0; }
  @container main (min-width: 540px) {
    .featured { grid-template-columns: 1.25fr 1fr; }
    .shot { border-bottom: 0; border-right: 1px solid var(--hairline); }
    .shot img { height: 100%; aspect-ratio: auto; min-height: 190px; max-height: 260px; }
    .featured-copy { align-self: center; padding: 16px 18px; }
  }

  .icon-view { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 4px; margin: 0; padding: 0; list-style: none; }

  .now { margin: 0 0 6px; padding: 12px 14px; }
  .now h2 { margin: 0 0 10px; }
  .rel-head { display: flex; gap: 10px; align-items: center; }
  .now :global(.rel-icon) { width: 34px; height: 34px; }
  .rel-id { min-width: 0; }
  .rel-app { color: var(--text); font-weight: 700; font-size: .875rem; }
  .rel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0 6px; margin: 1px 0 0; color: var(--text-3); font-size: .6875rem; }
  .rel-tag { font-family: var(--font-mono); font-size: .75rem; font-weight: 700; }
  .badge { padding: 0 6px; color: #fff; background: linear-gradient(#6fcf6a, #2f9a3a); border: 1px solid #2a7f33; border-radius: 999px; font-size: .5625rem; font-weight: 700; line-height: 1.5; text-shadow: 0 -1px 0 rgba(0, 0, 0, .2); }
  .rel-title { margin: 12px 0 4px; font: 700 .9375rem/1.35 var(--font-ui); }
  .rel-points { margin: 0 0 4px; padding-left: 16px; color: var(--text-2); font-size: .75rem; line-height: 1.45; }
  .rel-points li { margin-bottom: 4px; }
  .rel-points li::marker { color: var(--text-3); }
  .now .buttons { margin: 10px 0 0; }
  .side-col .listview .sub strong { color: var(--text-2); }
  .side-col .listview li:focus-within .sub strong { color: #fff; }

  @media (min-width: 700px) {
    .avatar { width: 72px; height: 72px; border-radius: 16px; }
    .about { gap: 18px; }
    .icon-view { grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); }
  }
</style>

<script>
  const id = location.hash.slice(1);
  const product = id.match(/^prg-(omnivoice|bootable|memxt|opal)$/);
  const post = id.match(/^doc-([a-z0-9-]+)$/);
  if (product) location.replace(`/${product[1]}/`);
  else if (post) location.replace(`/blog/${post[1]}/`);
</script>
