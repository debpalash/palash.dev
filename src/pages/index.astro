---
import { getCollection } from 'astro:content';
import Profile from '../layouts/Profile.astro';
import WorkFeed from '../components/profile/WorkFeed.astro';
import { SITE } from '../site.config';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
const gallery = await getCollection('gallery');

// ------------------------------------------------------------------
// structured data — the canonical entity graph for the site lives here,
// on the canonical homepage. /os intentionally does not repeat it.
// ------------------------------------------------------------------
const personId = `${SITE.url}/#person`;
const orgId = `${SITE.url}/#yupcha`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author,
      alternateName: [SITE.alternateName, 'Palash'],
      url: SITE.url,
      mainEntityOfPage: { '@id': `${SITE.url}/#webpage` },
      image: new URL(SITE.avatar, SITE.url).href,
      jobTitle: 'Software Engineer & Product Builder',
      description: SITE.description,
      sameAs: [SITE.github, SITE.x],
      knowsAbout: SITE.stack,
      homeLocation: {
        '@type': 'Place',
        name: 'Agartala, Tripura, India',
        address: { '@type': 'PostalAddress', addressLocality: 'Agartala', addressRegion: 'Tripura', addressCountry: 'IN' },
      },
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.company.name,
      url: SITE.company.url,
      description: SITE.company.tagline,
      founder: { '@id': personId },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: 'palash.dev',
      alternateName: [SITE.author, SITE.alternateName],
      inLanguage: 'en',
      publisher: { '@id': personId },
      hasPart: [
        { '@id': `${SITE.url}/blog/#blog` },
        ...products.map((product) => ({ '@id': `${SITE.url}/${product.id}/#app` })),
      ],
    },
    ...products.map((p) => {
      const repository = p.data.github ?? p.data.url;
      const readme = p.data.github ? `${p.data.github.replace(/\/$/, '')}#readme` : undefined;
      return {
        '@type': 'SoftwareApplication',
        '@id': `${SITE.url}/${p.id}/#app`,
        name: p.data.name,
        ...(p.data.alternateNames.length ? { alternateName: p.data.alternateNames } : {}),
        description: p.data.description,
        applicationCategory: p.data.category,
        operatingSystem: p.data.os,
        url: `${SITE.url}/${p.id}/`,
        ...(repository ? { codeRepository: repository } : {}),
        ...(readme ? { subjectOf: { '@type': 'CreativeWork', name: `${p.data.name} README`, url: readme } } : {}),
        ...(p.data.logoUrl ? { image: new URL(p.data.logoUrl, SITE.url).href } : {}),
        author: { '@id': personId },
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        ...(p.data.features.length ? { featureList: p.data.features.map((feature) => feature.title) } : {}),
        ...(p.data.keywords.length ? { keywords: p.data.keywords.join(', ') } : {}),
        ...(p.data.updatedDate ? { dateModified: p.data.updatedDate.toISOString() } : {}),
      };
    }),
  ],
};

/**
 * Links out in the wild point at desktop windows by hash (/#doc-hello-world,
 * /#prg-memxt …). Those hashes never reach the server, so forward them to /os
 * client-side instead of silently dropping the visitor on this page.
 */
const hashForward = [
  '(function(){try{',
  'var id=location.hash.slice(1);',
  'if(!id)return;',
  "var re=/^(about|programs|docs|gallery|company|experiments|terminal|contact|printer|prg-.+|doc-.+|gal-.+)$/;",
  "if(re.test(id))location.replace('/os#'+id);",
  '}catch(e){}})();',
].join('');
---

<Profile
  title={SITE.title}
  description={SITE.description}
  active="work"
  sectionHeading="Systems with a Point of View"
  sectionDescription="Open-source products built around a simple belief: powerful software should feel immediate, stay understandable, and belong to the person using it."
  schemaType="ProfilePage"
  mainEntityId={personId}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <script is:inline set:html={hashForward} />
  </Fragment>

  {products.length > 0 ? (
    <WorkFeed products={products} gallery={gallery} />
  ) : (
    <p class="feed-empty">Nothing here yet.</p>
  )}
</Profile>
