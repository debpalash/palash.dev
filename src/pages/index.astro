---
import FluxLayout from '../flux/components/FluxLayout.astro';
import Nav from '../flux/components/Nav.astro';
import FluxFooter from '../flux/components/FluxFooter.astro';
import Section from '../flux/components/Section.astro';
import Heading from '../flux/components/Heading.astro';
import Button from '../flux/components/Button.astro';
import Card from '../flux/components/Card.astro';
import Badge from '../flux/components/Badge.astro';
import Grid from '../flux/components/Grid.astro';
import Divider from '../flux/components/Divider.astro';
import ThemeToggle from '../flux/react/ThemeToggle';
import LiquidDrip from '../flux/react/LiquidDrip';
import ProjectCard3D from '../flux/react/ProjectCard3D';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order);
---

<FluxLayout title="Home">
  <Nav>
    <ThemeToggle client:load slot="actions" />
  </Nav>

  <!-- ═══ PROJECTS 3D CARDS ═══ -->
  <Section id="projects" style="padding-top:var(--spacing-16);padding-bottom:var(--spacing-16);">
    <div style="margin-bottom:var(--spacing-12);">
      <Heading level={2} marker="01">Projects</Heading>
    </div>
    
    <div style="display:flex;flex-direction:column;gap:var(--spacing-12);">
      {allProducts.map((p, index) => (
        <ProjectCard3D client:only="react" project={p} index={index} />
      ))}
    </div>
  </Section>

  <FluxFooter>
    <LiquidDrip client:visible dripCount={1} dripDistance={14} dripColor="var(--flux-fg-faint)">
      <a href="https://github.com/debpalash" target="_blank" rel="noopener" style="font-family:var(--font-mono);font-size:var(--text-sm);color:var(--flux-fg-muted);">GitHub</a>
    </LiquidDrip>
    <LiquidDrip client:visible dripCount={1} dripDistance={14} dripColor="var(--flux-fg-faint)">
      <a href="/rss.xml" style="font-family:var(--font-mono);font-size:var(--text-sm);color:var(--flux-fg-muted);">RSS</a>
    </LiquidDrip>
  </FluxFooter>
</FluxLayout>
