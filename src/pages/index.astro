---
import { getCollection } from 'astro:content';
import Profile from '../layouts/Profile.astro';
import WorkFeed from '../components/profile/WorkFeed.astro';
import { SITE } from '../site.config';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
const gallery = await getCollection('gallery');

// ------------------------------------------------------------------
// structured data — the canonical entity graph for the site lives here,
// on the canonical homepage. /os intentionally does not repeat it.
// ------------------------------------------------------------------
const personId = `${SITE.url}/#person`;
const orgId = `${SITE.url}/#yupcha`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author,
      alternateName: [SITE.alternateName, 'Palash'],
      url: SITE.url,
      image: new URL(SITE.avatar, SITE.url).href,
      jobTitle: 'Software Engineer & Product Builder',
      description: SITE.description,
      sameAs: [SITE.github],
      knowsAbout: SITE.stack,
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.company.name,
      url: SITE.company.url,
      description: SITE.company.tagline,
      founder: { '@id': personId },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: 'palash.dev',
      alternateName: [SITE.author, SITE.alternateName],
      publisher: { '@id': personId },
    },
    ...products.map((p) => ({
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/${p.id}#app`,
      name: p.data.name,
      ...(p.data.keywords.length ? { alternateName: p.data.keywords.slice(0, 3) } : {}),
      description: p.data.description,
      applicationCategory: p.data.category,
      operatingSystem: p.data.os,
      url: `${SITE.url}/${p.id}`,
      ...(p.data.url ? { codeRepository: p.data.url } : {}),
      author: { '@id': personId },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(p.data.keywords.length ? { keywords: p.data.keywords.join(', ') } : {}),
    })),
  ],
};

// brand + product terms people search for
const homeKeywords = [
  SITE.author,
  SITE.alternateName,
  'Palash Debnath engineer',
  `github.com/${SITE.handle}`,
  ...products.flatMap((p) => [p.data.name, ...p.data.keywords.slice(0, 2)]),
  SITE.company.name,
]
  .filter((v, i, a) => v && a.indexOf(v) === i)
  .join(', ');

/**
 * Links out in the wild point at desktop windows by hash (/#doc-hello-world,
 * /#prg-memxt …). Those hashes never reach the server, so forward them to /os
 * client-side instead of silently dropping the visitor on this page.
 */
const hashForward = [
  '(function(){try{',
  'var id=location.hash.slice(1);',
  'if(!id)return;',
  "var re=/^(about|programs|docs|gallery|company|experiments|terminal|contact|printer|prg-.+|doc-.+|gal-.+)$/;",
  "if(re.test(id))location.replace('/os#'+id);",
  '}catch(e){}})();',
].join('');
---

<Profile title={SITE.title} description={SITE.description} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <meta name="keywords" content={homeKeywords} />
    <script is:inline set:html={hashForward} />
  </Fragment>

  {products.length > 0 ? (
    <WorkFeed products={products} gallery={gallery} />
  ) : (
    <p class="feed-empty">Nothing here yet.</p>
  )}
</Profile>
