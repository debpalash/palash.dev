---
import { getCollection } from 'astro:content';
import Profile from '../layouts/Profile.astro';
import Section from '../components/page/Section.astro';
import WorkList from '../components/page/WorkList.astro';
import PostList from '../components/page/PostList.astro';
import LinkList from '../components/page/LinkList.astro';
import GalleryStrip from '../components/page/GalleryStrip.astro';
import { SITE } from '../site.config';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const experiments = await getCollection('experiments');
const gallery = await getCollection('gallery');
const company = await getCollection('company');

const recentPosts = posts.slice(0, 4);

// a couple of shots per project, ordered like the work list, so the strip
// reads as a sample rather than the full gallery
const productOrder = products.map((p) => p.id);
const shots = productOrder
  .flatMap((id) => gallery.filter((g) => g.data.group === id).slice(0, 2))
  .slice(0, 6);

const companyProjects = company.map((c) => ({
  name: c.data.name,
  description: c.data.description,
  url: c.data.url,
  lang: c.data.lang,
  logoUrl: c.data.logoUrl,
}));

const experimentItems = experiments.map((x) => ({
  name: x.data.name,
  description: x.data.description,
  url: x.data.url,
  lang: x.data.lang,
}));

// ------------------------------------------------------------------
// structured data — the canonical entity graph for the site lives here,
// on the canonical homepage. /os intentionally does not repeat it.
// ------------------------------------------------------------------
const personId = `${SITE.url}/#person`;
const orgId = `${SITE.url}/#yupcha`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author,
      alternateName: [SITE.alternateName, 'Palash'],
      url: SITE.url,
      image: new URL(SITE.avatar, SITE.url).href,
      jobTitle: 'Software Engineer & Product Builder',
      description: SITE.description,
      sameAs: [SITE.github],
      knowsAbout: SITE.stack,
      worksFor: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.company.name,
      url: SITE.company.url,
      description: SITE.company.tagline,
      founder: { '@id': personId },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: 'palash.dev',
      alternateName: [SITE.author, SITE.alternateName],
      publisher: { '@id': personId },
    },
    ...products.map((p) => ({
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/${p.id}#app`,
      name: p.data.name,
      ...(p.data.keywords.length ? { alternateName: p.data.keywords.slice(0, 3) } : {}),
      description: p.data.description,
      applicationCategory: p.data.category,
      operatingSystem: p.data.os,
      url: `${SITE.url}/${p.id}`,
      ...(p.data.url ? { codeRepository: p.data.url } : {}),
      author: { '@id': personId },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      ...(p.data.keywords.length ? { keywords: p.data.keywords.join(', ') } : {}),
    })),
  ],
};

// brand + product terms people search for
const homeKeywords = [
  SITE.author,
  SITE.alternateName,
  'Palash Debnath engineer',
  `github.com/${SITE.handle}`,
  ...products.flatMap((p) => [p.data.name, ...p.data.keywords.slice(0, 2)]),
  SITE.company.name,
]
  .filter((v, i, a) => v && a.indexOf(v) === i)
  .join(', ');

/**
 * Links out in the wild point at desktop windows by hash (/#doc-hello-world,
 * /#prg-memxt …). Those hashes never reach the server, so forward them to /os
 * client-side instead of silently dropping the visitor on this page.
 */
const hashForward = [
  '(function(){try{',
  'var id=location.hash.slice(1);',
  'if(!id)return;',
  "var re=/^(about|programs|docs|gallery|company|experiments|terminal|contact|printer|prg-.+|doc-.+|gal-.+)$/;",
  "if(re.test(id))location.replace('/os#'+id);",
  '}catch(e){}})();',
].join('');
---

<Profile title={SITE.title} description={SITE.description} active="work">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <meta name="keywords" content={homeKeywords} />
    <script is:inline set:html={hashForward} />
  </Fragment>

  <section class="hero">
    <h1>{SITE.author}</h1>
    <p class="hero-role">Software engineer · product builder</p>
    <p class="hero-blurb">
      I make developer tools, media platforms, and infrastructure that bridge
      low-level performance and high-level UX. Local-first where it counts,
      open source where it helps. Things that ship.
    </p>
    <p class="hero-meta">
      <span>{products.length} programs</span>
      <span>{posts.length} posts</span>
      <span>{experiments.length} experiments</span>
      <span>built from Agartala, India</span>
    </p>
  </section>

  <Section id="work" title="Work" lede="Products I design, build and maintain.">
    <WorkList products={products} />
  </Section>

  <Section id="writing" title="Writing" more="/blog" moreLabel="all posts">
    <PostList posts={recentPosts} />
  </Section>

  {shots.length > 0 && (
    <Section id="gallery" title="Screenshots">
      <GalleryStrip items={shots} linkToProduct />
    </Section>
  )}

  <Section
    id="experiments"
    title="Experiments"
    lede="Smaller things — spikes, prototypes and one-offs, all on GitHub."
  >
    <LinkList items={experimentItems} />
  </Section>

  <Section id="company" title="Company">
    <div class="company-card">
      <p class="company-name">{SITE.company.name}</p>
      <p class="company-blurb">{SITE.company.blurb}</p>
      <p class="btn-row">
        <a class="btn" href={SITE.company.url} target="_blank" rel="noopener">
          {SITE.company.url.replace('https://', '')} ↗
        </a>
      </p>
    </div>

    {companyProjects.length > 0 && (
      <div style="margin-top:1.5rem;">
        <LinkList items={companyProjects} />
      </div>
    )}
  </Section>
</Profile>
