---
interface Props {
  open: string;
  label: string;
  /** folder | file | exec | terminal — or pass a custom glyph */
  kind?: 'folder' | 'file' | 'exec' | 'terminal';
  glyph?: string;
}

const { open, label, kind, glyph } = Astro.props;
---

<button class="icon" data-open={open} aria-label={`Open ${label}`}>
  <span class="glyph" aria-hidden="true">
    {kind === 'folder' && (
      <svg viewBox="0 0 40 32" width="34" height="27">
        <path d="M3 7 L3 27 L37 27 L37 11 L19 11 L15 6 L3 6 Z" fill="color-mix(in srgb, currentColor 18%, transparent)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M3 13 L37 13" stroke="currentColor" stroke-width="1" opacity="0.5" />
      </svg>
    )}
    {kind === 'file' && (
      <svg viewBox="0 0 30 38" width="26" height="33">
        <path d="M4 3 L19 3 L26 10 L26 35 L4 35 Z" fill="color-mix(in srgb, currentColor 12%, transparent)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M19 3 L19 10 L26 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M8 16 h14 M8 21 h14 M8 26 h9" stroke="currentColor" stroke-width="1.5" opacity="0.7" />
      </svg>
    )}
    {kind === 'exec' && (
      <svg viewBox="0 0 30 38" width="26" height="33">
        <path d="M4 3 L19 3 L26 10 L26 35 L4 35 Z" fill="color-mix(in srgb, currentColor 12%, transparent)" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path d="M19 3 L19 10 L26 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <text x="15" y="28" text-anchor="middle" font-size="13" font-weight="bold" fill="currentColor" font-family="inherit">$</text>
      </svg>
    )}
    {kind === 'terminal' && (
      <svg viewBox="0 0 40 32" width="34" height="27">
        <rect x="2" y="3" width="36" height="26" rx="2" fill="color-mix(in srgb, currentColor 14%, transparent)" stroke="currentColor" stroke-width="2" />
        <path d="M8 11 L14 16 L8 21" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M17 21 h10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      </svg>
    )}
    {!kind && glyph}
  </span>
  <span>{label}</span>
</button>
