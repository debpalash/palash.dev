---
// Finder-style desktop icons, shown where the wallpaper has room beside the window.
const items = [
  { href: '/', label: 'palash.dev', kind: 'drive' },
  { href: '/resume.pdf', label: 'Résumé.pdf', kind: 'pdf' },
  { href: '/blog/', label: 'Writing', kind: 'folder' },
  { href: '/llms.txt', label: 'llms.txt', kind: 'text' },
];
---
<nav class="desk-icons" aria-label="Desktop">
  {items.map(item => <a href={item.href}>
    <span class="glyph" aria-hidden="true">
      {item.kind === 'drive' && <svg viewBox="0 0 48 48"><defs><linearGradient id="dk-drive" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4f5f7"/><stop offset=".55" stop-color="#c9ccd2"/><stop offset="1" stop-color="#9ea3ab"/></linearGradient></defs><rect x="4" y="14" width="40" height="22" rx="3" fill="url(#dk-drive)" stroke="#6d727a"/><path d="M5 28h38" stroke="#8c9098"/><circle cx="37" cy="32" r="1.6" fill="#5fd35a"/><rect x="9" y="31" width="14" height="2" rx="1" fill="#8c9098"/></svg>}
      {item.kind === 'pdf' && <svg viewBox="0 0 48 48"><path d="M11 4h19l9 9v31H11Z" fill="#fff" stroke="#9aa0a8"/><path d="M30 4v9h9" fill="#e9ecf0" stroke="#9aa0a8"/><rect x="8" y="26" width="26" height="11" rx="2" fill="#d6302b"/><text x="21" y="34.5" text-anchor="middle" font-size="8" font-weight="700" font-family="Helvetica, Arial, sans-serif" fill="#fff">PDF</text><path d="M15 15h11M15 19h18M15 41h18" stroke="#c4c9d0" stroke-width="1.6"/></svg>}
      {item.kind === 'folder' && <svg viewBox="0 0 48 48"><defs><linearGradient id="dk-folder" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fd1ff"/><stop offset="1" stop-color="#3b86dc"/></linearGradient></defs><path d="M4 12a2 2 0 0 1 2-2h12l4 4h20a2 2 0 0 1 2 2v22a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" fill="url(#dk-folder)" stroke="#2f6fbf"/><path d="M4 18h40" stroke="#bfe0ff" stroke-width="1.5"/></svg>}
      {item.kind === 'text' && <svg viewBox="0 0 48 48"><path d="M11 4h19l9 9v31H11Z" fill="#fff" stroke="#9aa0a8"/><path d="M30 4v9h9" fill="#e9ecf0" stroke="#9aa0a8"/><path d="M15 18h19M15 22h19M15 26h19M15 30h19M15 34h12" stroke="#8a93a0" stroke-width="1.4"/></svg>}
    </span>
    <span class="label">{item.label}</span>
  </a>)}
</nav>

<style>
  .desk-icons { position: absolute; top: 14px; right: 14px; z-index: 0; display: none; gap: 14px; justify-items: center; }
  @media (min-width: 1580px) { .desk-icons { display: grid; } }
  @media (min-width: 700px) { :global(html.minimized) .desk-icons { display: grid; } }
  :global(html.zoomed:not(.minimized)) .desk-icons { display: none; }
  a { display: grid; justify-items: center; gap: 3px; width: 86px; color: #fff; text-decoration: none; }
  a:hover { text-decoration: none; }
  a:focus-visible { box-shadow: none; }
  .glyph { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 6px; }
  .glyph svg { width: 48px; height: 48px; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, .35)); }
  .label { max-width: 100%; padding: 0 5px; overflow: hidden; border-radius: 4px; font-size: .75rem; font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 1px 2px rgba(0, 0, 0, .8); }
  a:focus-visible .glyph, a:active .glyph { background: rgba(0, 0, 0, .25); box-shadow: 0 0 0 1px rgba(255, 255, 255, .25); }
  a:focus-visible .label, a:active .label { background: linear-gradient(var(--select-top), var(--select-bottom)); text-shadow: none; }
</style>
