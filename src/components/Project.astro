---
import { latestRelease, type Product } from '../lib/content';
import AppIcon from './AppIcon.astro';
interface Props { product: Product; tone: number }
const { product: p, tone } = Astro.props;
const release = latestRelease(p.id);
---
<li class={`item tone-${tone % 6}`}>
  <a href={`/${p.id}/`}>
    <AppIcon product={p} tone={tone} size={58} class="tile" />
    <span class="name">{p.name}</span>
    <span class="meta">{p.tagline}</span>
  </a>
  <span class="pill-slot" data-live-release={p.id}>
    {!release && <span class="release dev" title="No public release yet"><span class="dot" aria-hidden="true"></span>In development</span>}
    {release && <a class="release" href={release.url} title={release.title || release.name}><span class="dot" aria-hidden="true"></span>{release.tag} · <time class="ago short" datetime={release.publishedAt}>{release.publishedAt.slice(0, 10)}</time></a>}
  </span>
</li>

<style>
  .item { display: grid; justify-items: center; align-content: start; }
  .pill-slot { display: contents; }
  .item > a:first-child { display: grid; justify-items: center; gap: 3px; padding: 8px 4px 6px; color: var(--text); border-radius: 6px; text-align: center; text-decoration: none; }
  .item > a:first-child:focus-visible { box-shadow: none; }
  .release { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; margin-top: 1px; padding: 0 7px; overflow: hidden; color: var(--text-2); background: var(--token-bg); border: 1px solid var(--token-edge); border-radius: 999px; font-size: .625rem; line-height: 1.6; text-decoration: none; white-space: nowrap; }
  .release:hover { text-decoration: none; border-color: var(--aqua-mid); }
  .release:active { filter: brightness(.9); }
  .release.dev { color: var(--text-3); background: transparent; border-style: dashed; border-color: var(--hairline); }
  .release.dev .dot { background: radial-gradient(circle at 40% 35%, #ffe7a0, #d99a1c); }
  .dot { flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #b6f0a8, #2f9a3a); box-shadow: 0 0 0 .5px rgba(0, 0, 0, .3); }
  .item :global(.tile) { width: 58px; height: 58px; margin-bottom: 3px; transition: transform .15s ease; }
  .name { max-width: 100%; padding: 0 6px; overflow: hidden; border-radius: 4px; font-size: .75rem; font-weight: 700; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
  .meta { display: -webkit-box; overflow: hidden; color: var(--text-3); font-size: .6875rem; line-height: 1.3; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  /* Finder selection: grey plate behind the icon, blue pill behind the name */
  .item > a:first-child:hover { text-decoration: none; }
  .item :global(.tile) { padding: 0; border-radius: 8px; }
  .item > a:first-child:focus-visible :global(.tile), .item > a:first-child:active :global(.tile) { background-color: rgba(0, 0, 0, .14); box-shadow: 0 0 0 5px rgba(0, 0, 0, .14); }
  .item > a:first-child:focus-visible .name, .item > a:first-child:active .name { color: #fff; background: linear-gradient(var(--select-top), var(--select-bottom)); }
  @media (prefers-color-scheme: dark) { .item > a:first-child:focus-visible :global(.tile), .item > a:first-child:active :global(.tile) { background-color: rgba(255, 255, 255, .14); box-shadow: 0 0 0 5px rgba(255, 255, 255, .14); } }
</style>
