---
import type { CollectionEntry } from 'astro:content';
import FeedItem from './FeedItem.astro';

interface Props {
  items: CollectionEntry<'experiments'>[];
}

const { items } = Astro.props;
---

<div class="feed-list">
  {items.map((x) => (
    <FeedItem
      href={x.data.url}
      title={x.data.name}
      meta={x.data.lang}
      icon="◇"
      external
    >{x.data.description}</FeedItem>
  ))}
</div>
