---
import type { CollectionEntry } from 'astro:content';
import FeedItem from './FeedItem.astro';

interface Props {
  products: CollectionEntry<'products'>[];
  gallery: CollectionEntry<'gallery'>[];
}

const { products, gallery } = Astro.props;

/** first screenshot of each product, attached to its row like a media post */
const shotFor = (id: string) => gallery.find((g) => g.data.group === id);
---

<div class="feed-list">
  {products.map((p) => {
    const shot = shotFor(p.id);
    return (
      <FeedItem
        href={`/${p.id}`}
        title={p.data.name}
        meta={`@${p.id}`}
        icon={p.data.icon}
        logoUrl={p.data.logoUrl}
        image={p.data.workImage ?? shot?.data.src}
        imageAlt={p.data.workImage ? `${p.data.name} launchpad` : shot?.data.title}
        website={p.data.website}
        github={p.data.github ?? p.data.url}
        downloadUrl={p.data.github ? `${p.data.github.replace(/\/$/, '')}/releases` : undefined}
        stars={p.data.stars}
        license={p.data.license}
        pricing={p.data.pricing}
        openSource={p.data.openSource}
        status={p.data.status}
        theme={p.data.theme}
      >{p.data.tagline}</FeedItem>
    );
  })}
</div>
