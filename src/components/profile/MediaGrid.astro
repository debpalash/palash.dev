---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'gallery'>[];
}

const { items } = Astro.props;
---

<div class="mgrid" data-pswp-gallery>
  {items.map((item) => (
    <figure class="mtile">
      <a
        class="mtile-image"
        href={item.data.src}
        target="_blank"
        rel="noopener"
        aria-label={`Open ${item.data.title}`}
        data-pswp-item
        data-pswp-width="1600"
        data-pswp-height="1000"
        data-pswp-caption={item.data.caption}
      >
        <img src={item.data.src} alt={item.data.title} width="420" height="263" loading="lazy" decoding="async" />
      </a>
      <figcaption class="mtile-caption">
        <span>{item.data.caption}</span>
        <a href={`/${item.data.group}`}>view project ↗</a>
      </figcaption>
    </figure>
  ))}
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const initPhotoSwipe = () => {
    document.querySelectorAll('[data-pswp-gallery]:not([data-pswp-initialized])').forEach((gallery) => {
      const lightbox = new PhotoSwipeLightbox({
        gallery,
        children: 'a[data-pswp-item]',
        pswpModule: () => import('photoswipe'),
      });
      lightbox.on('uiRegister', () => {
        lightbox.pswp?.ui.registerElement({
          name: 'caption',
          className: 'pswp__caption',
          order: 9,
          isButton: false,
          appendTo: 'root',
          onInit: (element, pswp) => {
            pswp.on('change', () => {
              element.textContent = pswp.currSlide?.data.element?.dataset.pswpCaption ?? '';
            });
          },
        });
      });
      lightbox.init();
      gallery.setAttribute('data-pswp-initialized', 'true');
    });
  };

  document.addEventListener('astro:page-load', initPhotoSwipe);
  initPhotoSwipe();
</script>
