---
/**
 * Shared document head for both shells — the retro desktop (OS.astro) and
 * the plain reading pages (Page.astro). Kept in one place so the two modes
 * can't drift apart on canonical URLs, OG tags or feed discovery.
 */
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Open Graph type — 'website' for most pages, 'article' for blog posts */
  ogType?: string;
  /** theme-color meta; the desktop overrides it with its own dark value */
  themeColor?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noIndex?: boolean;
  /** schema.org page type; specialized pages can use ProfilePage/CollectionPage */
  schemaType?: string | string[];
  /** canonical entity this page is primarily presenting */
  mainEntityId?: string;
  /** breadcrumb node emitted by the route-level graph */
  breadcrumbId?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.png',
  ogType = 'website',
  themeColor = '#ffffff',
  publishedTime,
  modifiedTime,
  tags = [],
  noIndex = false,
  schemaType = 'WebPage',
  mainEntityId,
  breadcrumbId,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.title || title.length > 48 ? title : `${title} | palash.dev`;
const ogImageUrl = new URL(ogImage, Astro.site);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="text/markdown" title="LLM context" href="/llms.txt" />
<link rel="alternate" type="text/markdown" title="Full LLM context" href="/llms-full.txt" />
<link rel="alternate" type="text/plain" title="Humans.txt" href="/humans.txt" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.author} RSS Feed`}
  href="/rss.xml"
/>

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<link rel="canonical" href={canonicalUrl} />
<link rel="me" href={SITE.x} />
<link rel="author" href={`${SITE.url}/#person`} />
<meta name="author" content={SITE.author} />
<meta http-equiv="content-language" content="en" />
<meta name="application-name" content="palash.dev" />
<meta name="theme-color" content={themeColor} />
<meta name="format-detection" content="telephone=no" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="palash.dev" />
<meta property="og:locale" content="en_US" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:secure_url" content={ogImageUrl} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:creator" content="@idebpalash" />
<meta name="twitter:site" content="@idebpalash" />

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': schemaType,
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl.href,
  name: fullTitle,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#person` },
  ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
  ...(breadcrumbId ? { breadcrumb: { '@id': breadcrumbId } } : {}),
})} />
