---
import type { CollectionEntry } from 'astro:content';
import 'photoswipe/style.css';

interface Props {
  items: CollectionEntry<'gallery'>[];
  /** link each shot to the product page for its group instead of the raw image */
  linkToProduct?: boolean;
}

const { items, linkToProduct = false } = Astro.props;
---

<div class="gallery-strip" data-pswp-gallery>
  {items.map((item) => (
    <a
      class="shot"
      href={linkToProduct ? `/${item.data.group}` : item.data.src}
      target={linkToProduct ? undefined : '_blank'}
      rel={linkToProduct ? undefined : 'noopener'}
      aria-label={item.data.title}
      data-pswp-item={!linkToProduct ? true : undefined}
      data-pswp-width={!linkToProduct ? 1600 : undefined}
      data-pswp-height={!linkToProduct ? 1000 : undefined}
      data-pswp-caption={!linkToProduct ? item.data.caption : undefined}
    >
      <img
        src={`/gallery/${item.id}.webp`}
        alt={item.data.title}
        width="600"
        height="375"
        loading="lazy"
        decoding="async"
      />
      <span class="shot-cap">{item.data.caption}</span>
    </a>
  ))}
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  const initPhotoSwipe = () => {
    document.querySelectorAll('[data-pswp-gallery]:not([data-pswp-initialized])').forEach((gallery) => {
      const lightbox = new PhotoSwipeLightbox({
        gallery,
        children: 'a[data-pswp-item]',
        pswpModule: () => import('photoswipe'),
      });
      lightbox.on('uiRegister', () => {
        lightbox.pswp?.ui.registerElement({
          name: 'caption',
          className: 'pswp__caption',
          order: 9,
          isButton: false,
          appendTo: 'root',
          onInit: (element, pswp) => {
            pswp.on('change', () => {
              element.textContent = pswp.currSlide?.data.element?.dataset.pswpCaption ?? '';
            });
          },
        });
      });
      lightbox.init();
      gallery.setAttribute('data-pswp-initialized', 'true');
    });
  };

  initPhotoSwipe();
</script>
