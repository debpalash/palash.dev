---
interface Props {
  id: string;
  title: string;
  /** optional "see all" link on the right of the section heading */
  more?: string;
  moreLabel?: string;
  lede?: string;
}

const { id, title, more, moreLabel, lede } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-head">
    <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    {more && (
      <a class="section-more" href={more}>{moreLabel ?? 'see all'} →</a>
    )}
  </div>
  {lede && <p class="section-lede">{lede}</p>}
  <slot />
</section>
