---
/**
 * Outbound list shared by the experiments and company-projects sections —
 * both are just name / description / language pointing off-site.
 */
interface Item {
  name: string;
  description: string;
  url: string;
  lang?: string;
  category?: string;
  logoUrl?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="rows">
  {items.map((item) => (
    <a class="row" href={item.url} target="_blank" rel="noopener">
      {item.logoUrl && (
        <img class="row-icon" src={item.logoUrl} alt="" width="32" height="32" loading="lazy" />
      )}

      <div class="row-body">
        <div class="row-title">{item.name}</div>
        <p class="row-desc">{item.description}</p>
      </div>

      <span class="row-arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>
