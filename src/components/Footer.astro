---
import type { PageData } from '../lib/page-data';
import { SITE } from '../site.config';
interface Props { page: PageData }
const { page } = Astro.props;
const section = page.path.startsWith('/blog/') ? '/blog/' : page.product ? '/' : page.path;
const apps = [
  { href: '/', label: 'Work', icon: 'work' },
  { href: '/blog/', label: 'Writing', icon: 'writing' },
  { href: '/lab/', label: 'Lab', icon: 'lab' },
  { href: '/media/', label: 'Media', icon: 'media' },
  { href: '/resume/', label: 'Résumé', icon: 'resume' },
  { href: '/contact/', label: 'Contact', icon: 'contact' },
  { href: '/search/', label: 'Search', icon: 'search' },
];
const extras = [
  { href: SITE.github, label: 'GitHub', icon: 'github' },
  { href: '/rss.xml', label: 'RSS', icon: 'rss' },
];
---
<footer class="dock-area">
  <nav class="dock" aria-label="Primary">
    <ul>
      {apps.map(app => <li><a class="dock-item" href={app.href} aria-current={page.path === app.href ? 'page' : undefined} data-running={section === app.href ? '' : undefined}>
        <span class={`tile t-${app.icon}`} aria-hidden="true">
          {app.icon === 'work' && <svg viewBox="0 0 24 24"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.2l1.6 1.8h9.2A1.5 1.5 0 0 1 21 9.3v8.2a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5Z" fill="rgba(255,255,255,.92)"/><path d="M3 10.5h18" stroke="rgba(30,90,170,.35)" stroke-width="1"/></svg>}
          {app.icon === 'writing' && <svg viewBox="0 0 24 24"><rect x="5" y="3.5" width="14" height="17" rx="1.5" fill="#fffdf2"/><path d="M8 8h8M8 11h8M8 14h8M8 17h5" stroke="#9fb7d9" stroke-width="1"/><path d="M5 3.5h14v2.5H5z" fill="#e8b93a"/></svg>}
          {app.icon === 'lab' && <svg viewBox="0 0 24 24"><path d="M9.5 3.5h5M10.5 3.5v6L5.2 18a1.6 1.6 0 0 0 1.4 2.5h10.8a1.6 1.6 0 0 0 1.4-2.5l-5.3-8.5v-6" fill="rgba(255,255,255,.25)" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/><path d="M7.3 15h9.4l1.8 3a1 1 0 0 1-.9 1.5H6.4a1 1 0 0 1-.9-1.5Z" fill="#d7ffd0"/></svg>}
          {app.icon === 'media' && <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="1.5" fill="#fff"/><rect x="5" y="6.5" width="14" height="11" fill="#7fb8f0"/><path d="m5 17.5 4.5-5.5 3 3.5 2-2 4.5 4Z" fill="#3f8a4a"/><circle cx="15.5" cy="9.5" r="1.5" fill="#ffe27a"/></svg>}
          {app.icon === 'resume' && <svg viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="#fff"/><circle cx="9" cy="11" r="2.3" fill="#6b7688"/><path d="M5.8 16.2a3.4 3.4 0 0 1 6.4 0" fill="#6b7688"/><path d="M14 10h4.5M14 12.5h4.5M14 15h3" stroke="#aab2bf" stroke-width="1.2"/></svg>}
          {app.icon === 'contact' && <svg viewBox="0 0 24 24"><rect x="3.5" y="6" width="17" height="12" rx="1.5" fill="#fff"/><path d="m4 7 8 6 8-6" fill="none" stroke="#3a7fd8" stroke-width="1.4" stroke-linejoin="round"/></svg>}
          {app.icon === 'search' && <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5" fill="rgba(255,255,255,.55)" stroke="#39414d" stroke-width="2"/><path d="m14.6 14.6 5 5" stroke="#39414d" stroke-width="2.6" stroke-linecap="round"/></svg>}
        </span>
        <span class="label">{app.label}</span>
      </a></li>)}
      <li class="divider" aria-hidden="true"></li>
      {extras.map(app => <li class="extra"><a class="dock-item" href={app.href} rel={app.icon === 'github' ? 'me' : undefined}>
        <span class={`tile t-${app.icon}`} aria-hidden="true">
          {app.icon === 'github' && <svg viewBox="0 0 24 24"><path d="m8.5 7.5-4.5 4.5 4.5 4.5m7-9 4.5 4.5-4.5 4.5M13.5 5l-3 14" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>}
          {app.icon === 'rss' && <svg viewBox="0 0 24 24"><circle cx="6.5" cy="17.5" r="2" fill="#fff"/><path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5M4.5 5a14.5 14.5 0 0 1 14.5 14.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>}
        </span>
        <span class="label">{app.label}</span>
      </a></li>)}
    </ul>
  </nav>
</footer>

<script>
  const dock = document.querySelector<HTMLElement>('.dock')!;
  const items = [...dock.querySelectorAll<HTMLLIElement>('li:not(.divider)')];
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 700px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  // Magnification: each icon scales with the cursor's distance from its resting centre,
  // widening its slot so neighbours slide apart, like the real Dock.
  const MAX = 1.75;
  let centres: number[] = [];
  let frame = 0;
  let pointerX = 0;
  const measure = () => {
    items.forEach(li => li.style.removeProperty('--s'));
    centres = items.map(li => { const r = li.getBoundingClientRect(); return r.left + r.width / 2; });
  };
  const paint = () => {
    frame = 0;
    const tile = items[0]?.querySelector('.tile')?.getBoundingClientRect().height ?? 42;
    const range = tile * 3.2;
    items.forEach((li, i) => {
      const d = Math.abs(pointerX - centres[i]);
      const s = d >= range ? 1 : 1 + (MAX - 1) * (Math.cos(Math.PI * d / range) + 1) / 2;
      li.style.setProperty('--s', s.toFixed(3));
    });
  };
  dock.addEventListener('pointerenter', e => {
    if (!fine.matches || still.matches || e.pointerType !== 'mouse') return;
    measure();
    dock.classList.add('magnifying');
  });
  dock.addEventListener('pointermove', e => {
    if (!dock.classList.contains('magnifying')) return;
    pointerX = e.clientX;
    if (!frame) frame = requestAnimationFrame(paint);
  });
  dock.addEventListener('pointerleave', () => {
    cancelAnimationFrame(frame); frame = 0;
    dock.classList.remove('magnifying');
    items.forEach(li => li.style.removeProperty('--s'));
  });

  // Launch: the clicked icon bounces and hands its box to the incoming window (see Site.astro).
  for (const link of dock.querySelectorAll<HTMLAnchorElement>('a.dock-item')) {
    link.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      if (link.origin !== location.origin) return;
      if (document.documentElement.classList.contains('minimized') && link.hasAttribute('data-running')) {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('window:restore', { detail: link }));
        return;
      }
      if (link.getAttribute('aria-current') === 'page') { e.preventDefault(); return; }
      link.classList.add('launching');
      try { sessionStorage.setItem('launch', '1'); } catch {}
    });
  }
  addEventListener('pageswap', (e: Event) => {
    const vt = (e as Event & { viewTransition?: ViewTransition & { types?: Set<string> } }).viewTransition;
    const tile = dock.querySelector<HTMLElement>('.dock-item.launching .tile');
    if (!vt || !tile) return;
    vt.types?.add('launch-from');
    tile.style.viewTransitionName = 'window';
  });
  addEventListener('pageshow', () => {
    for (const link of dock.querySelectorAll('.launching')) link.classList.remove('launching');
    for (const tile of dock.querySelectorAll<HTMLElement>('.tile')) tile.style.removeProperty('view-transition-name');
  });
</script>

<style>
  .dock-area { position: relative; z-index: 2; display: flex; justify-content: center; padding: 6px 6px calc(4px + env(safe-area-inset-bottom)); }
  .dock { position: relative; }
  .dock::before { content: ''; position: absolute; inset: 10px -2px 0; z-index: -1; background: linear-gradient(rgba(255, 255, 255, .5), rgba(255, 255, 255, .22)); border: 1px solid rgba(255, 255, 255, .65); border-radius: 12px; box-shadow: 0 8px 26px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(255, 255, 255, .8); -webkit-backdrop-filter: blur(16px) saturate(1.5); backdrop-filter: blur(16px) saturate(1.5); }
  ul { display: flex; align-items: flex-end; gap: 2px; margin: 0; padding: 0 4px; list-style: none; }
  .dock-item { position: relative; display: grid; justify-items: center; width: calc(var(--tile) + 6px); padding-top: 2px; color: var(--text); text-decoration: none; -webkit-touch-callout: none; }
  .dock-item:hover { text-decoration: none; }
  .dock-item:focus-visible { box-shadow: none; }
  .dock-item:focus-visible .tile { box-shadow: 0 0 0 3px rgba(64, 145, 235, .7); }
  .tile { position: relative; display: grid; place-items: center; width: var(--tile); height: var(--tile); border-radius: 22%; box-shadow: 0 2px 5px rgba(0, 0, 0, .3), inset 0 0 0 .5px rgba(0, 0, 0, .3); transform-origin: 50% 100%; transform: scale(var(--s, 1)); transition: transform .22s cubic-bezier(.2, .8, .3, 1); }
  .tile::after { content: ''; position: absolute; inset: 1px 2px 50%; border-radius: 22% 22% 45% 45% / 30% 30% 18% 18%; background: linear-gradient(rgba(255, 255, 255, .6), rgba(255, 255, 255, .05)); pointer-events: none; }
  .tile svg { width: 72%; height: 72%; filter: drop-shadow(0 1px 1px rgba(0, 0, 0, .25)); }
  .t-work { background: linear-gradient(#8cc8ff, #2c78dc); }
  .t-writing { background: linear-gradient(#fff0a8, #f0b02a); }
  .t-lab { background: linear-gradient(#9ee8a0, #2c9448); }
  .t-media { background: linear-gradient(#ffbd98, #d65a8e); }
  .t-resume { background: linear-gradient(#b3bdca, #505b6c); }
  .t-contact { background: linear-gradient(#a5dcff, #3a8ce0); }
  .t-search { background: linear-gradient(#f4f6f9, #aab2be); }
  .t-github { background: linear-gradient(#666a72, #16181c); }
  .t-rss { background: linear-gradient(#ffc070, #e8651c); }
  .label { margin-top: 2px; font-size: 9px; line-height: 1.2; letter-spacing: -.01em; white-space: nowrap; text-shadow: 0 1px 0 rgba(255, 255, 255, .5); }
  .dock-item[data-running]::after { content: ''; position: absolute; bottom: -3px; width: 4px; height: 4px; border-radius: 50%; background: radial-gradient(circle, #fff 0 30%, #8fd0ff 60%, transparent 70%); box-shadow: 0 0 5px 1px rgba(120, 200, 255, .9); }
  .divider, .extra { display: none; }
  .dock-item:active .tile { filter: brightness(.7); }

  @media (min-width: 700px) {
    .dock-area { padding-bottom: 4px; }
    .dock::before { inset: 14px -4px 0; border-radius: 10px 10px 4px 4px; }
    ul { gap: 4px; padding: 0 8px 5px; }
    .dock-item { width: calc((var(--tile) + 4px) * var(--s, 1)); transition: width .22s cubic-bezier(.2, .8, .3, 1); }
    .dock.magnifying .dock-item, .dock.magnifying .tile { transition-duration: .06s; transition-timing-function: linear; }
    .divider { display: block; width: 1px; height: calc(var(--tile) - 4px); margin: 0 5px 2px; background: linear-gradient(transparent, rgba(0, 0, 0, .3) 30%, rgba(0, 0, 0, .3)); box-shadow: 1px 0 0 rgba(255, 255, 255, .5); }
    .extra { display: block; }
    .label { position: absolute; bottom: calc(100% + 12px + var(--tile) * (var(--s, 1) - 1)); padding: 1px 9px; color: #fff; background: rgba(20, 20, 24, .8); border-radius: 999px; font-size: .75rem; opacity: 0; text-shadow: none; transform: translateY(4px); transition: opacity .12s, transform .12s; pointer-events: none; }
    .dock-item:hover .label, .dock-item:focus-visible .label { opacity: 1; transform: none; }
    .dock-item[data-running]::after { bottom: -6px; }
  }
  /* Launch bounce while the window opens */
  .dock-item.launching .tile { animation: bounce .5s cubic-bezier(.3, 0, .3, 1); }
  @keyframes bounce { 40% { translate: 0 -14px; } 70% { translate: 0 0; } 85% { translate: 0 -4px; } }
  @media (prefers-color-scheme: dark) {
    .dock::before { background: linear-gradient(rgba(70, 74, 92, .55), rgba(30, 32, 44, .45)); border-color: rgba(255, 255, 255, .16); }
    .label { text-shadow: 0 1px 0 rgba(0, 0, 0, .6); }
  }
</style>
