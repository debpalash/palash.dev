---
// One-word-at-a-time reader (RSVP) in a classic OS X HUD panel. Words come from the rendered article.
interface Props { source: string; title: string }
const { source, title } = Astro.props;
---
<button type="button" class="button primary speed-open" data-source={source} aria-haspopup="dialog">Speed Read</button>

<dialog class="hud" aria-label={`Speed read: ${title}`}>
  <div class="hud-bar">
    <button type="button" class="hud-close" data-close aria-label="Close speed reader">×</button>
    <span class="hud-title">Speed Read</span>
  </div>
  <div class="stage" aria-live="off">
    <span class="tick top" aria-hidden="true"></span>
    <p class="word"><span class="pre"></span><span class="pivot"></span><span class="post"></span></p>
    <span class="tick bottom" aria-hidden="true"></span>
  </div>
  <input class="scrub" type="range" min="0" value="0" step="1" aria-label="Position" />
  <div class="hud-controls">
    <button type="button" data-jump="-10" aria-label="Back 10 words">◀◀</button>
    <button type="button" class="play" aria-label="Play">▶</button>
    <button type="button" data-jump="10" aria-label="Forward 10 words">▶▶</button>
    <label class="wpm"><input type="range" min="150" max="900" step="25" value="350" aria-label="Words per minute" /><output>350</output> wpm</label>
    <span class="left"></span>
  </div>
  <p class="hint">Space play/pause · ← → skip · ↑ ↓ speed · Esc close</p>
</dialog>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  for (const opener of document.querySelectorAll<HTMLButtonElement>('.speed-open')) {
    const hud = opener.nextElementSibling as HTMLDialogElement;
    const [pre, pivot, post] = [...hud.querySelectorAll<HTMLSpanElement>('.word span')];
    const play = hud.querySelector<HTMLButtonElement>('.play')!;
    const scrub = hud.querySelector<HTMLInputElement>('.scrub')!;
    const speed = hud.querySelector<HTMLInputElement>('.wpm input')!;
    const speedOut = hud.querySelector('output')!;
    const left = hud.querySelector<HTMLElement>('.left')!;
    let words: string[] = [];
    let pauses: number[] = [];
    let i = 0;
    let timer = 0;

    try { const saved = Number(localStorage.getItem('speed-read-wpm')); if (saved >= 150 && saved <= 900) speed.value = String(saved); } catch {}
    speedOut.textContent = speed.value;

    // Collect words in reading order; headings and paragraph ends earn a longer beat.
    const collect = () => {
      const root = document.querySelector(opener.dataset.source!);
      words = []; pauses = [];
      root?.querySelectorAll('p, li, h2, h3, blockquote > p').forEach(block => {
        if (block.closest('nav, pre, .speed-skip') || (block.tagName === 'P' && block.closest('li'))) return;
        const list = (block.textContent ?? '').split(/\s+/).filter(Boolean);
        list.forEach((w, n) => { words.push(w); pauses.push(n === list.length - 1 ? (block.tagName.startsWith('H') ? 3 : 2.2) : 1); });
      });
      scrub.max = String(Math.max(0, words.length - 1));
    };
    // Optimal recognition point: the letter the eye should land on.
    const orp = (w: string) => { const n = w.replace(/[^\p{L}\p{N}]/gu, '').length; return n <= 1 ? 0 : n <= 5 ? 1 : n <= 9 ? 2 : n <= 13 ? 3 : 4; };
    const render = () => {
      const w = words[i] ?? '';
      const lead = w.match(/^[^\p{L}\p{N}]*/u)?.[0].length ?? 0;
      const k = Math.min(w.length - 1, lead + orp(w));
      pre.textContent = w.slice(0, k); pivot.textContent = w.charAt(k); post.textContent = w.slice(k + 1);
      scrub.value = String(i);
      const minutes = (words.length - i) / Number(speed.value);
      left.textContent = minutes < 1 ? `${Math.max(1, Math.round(minutes * 60))}s left` : `${Math.ceil(minutes)} min left`;
    };
    const delay = () => {
      const w = words[i] ?? '';
      let factor = pauses[i] ?? 1;
      if (/[.!?]["')\]]*$/.test(w)) factor = Math.max(factor, 2);
      else if (/[,;:—–]["')\]]*$/.test(w)) factor = Math.max(factor, 1.4);
      if (w.length > 9) factor *= 1.25;
      return (60000 / Number(speed.value)) * factor;
    };
    const stop = () => { clearTimeout(timer); timer = 0; play.textContent = '▶'; play.setAttribute('aria-label', 'Play'); };
    const step = () => {
      render();
      if (i >= words.length - 1) { stop(); return; }
      timer = window.setTimeout(() => { i++; step(); }, delay());
    };
    const start = () => { if (i >= words.length - 1) i = 0; play.textContent = '❚❚'; play.setAttribute('aria-label', 'Pause'); step(); };
    const toggle = () => (timer ? stop() : start());
    const jump = (n: number) => { i = Math.min(Math.max(0, i + n), words.length - 1); render(); };

    opener.addEventListener('click', () => {
      if (!words.length) collect();
      render();
      hud.showModal();
      hud.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: still.matches ? 1 : 180, easing: 'ease-out' });
      window.setTimeout(start, still.matches ? 0 : 500);
    });
    hud.addEventListener('close', stop);
    hud.addEventListener('click', e => {
      const t = e.target as HTMLElement;
      if (t === hud || t.closest('[data-close]')) hud.close();
      const j = t.closest<HTMLElement>('[data-jump]');
      if (j) jump(Number(j.dataset.jump));
      if (t.closest('.play')) toggle();
    });
    hud.addEventListener('keydown', e => {
      if (e.target instanceof HTMLInputElement && e.key !== ' ' && e.key !== 'Escape') return;
      if (e.key === ' ') { e.preventDefault(); toggle(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); jump(timer ? -10 : -1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); jump(timer ? 10 : 1); }
      else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        speed.value = String(Number(speed.value) + (e.key === 'ArrowUp' ? 25 : -25));
        speed.dispatchEvent(new Event('input'));
      }
    });
    scrub.addEventListener('input', () => { i = Number(scrub.value); render(); });
    speed.addEventListener('input', () => {
      speedOut.textContent = speed.value;
      try { localStorage.setItem('speed-read-wpm', speed.value); } catch {}
      render();
    });
  }
</script>

<style>
  .hud { width: min(560px, calc(100vw - 20px)); padding: 0 0 12px; overflow: hidden; color: #f2f2f2; background: rgba(22, 22, 26, .9); border: 1px solid rgba(255, 255, 255, .18); border-radius: 12px; box-shadow: 0 24px 60px rgba(0, 0, 0, .5), inset 0 1px 0 rgba(255, 255, 255, .12); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); font-family: var(--font-ui); }
  .hud::backdrop { background: rgba(0, 0, 0, .35); }
  .hud-bar { position: relative; display: flex; align-items: center; justify-content: center; height: 22px; background: linear-gradient(rgba(255, 255, 255, .12), rgba(255, 255, 255, .03)); border-bottom: 1px solid rgba(255, 255, 255, .08); }
  .hud-title { font-size: .6875rem; font-weight: 700; letter-spacing: .02em; opacity: .85; }
  .hud-close { position: absolute; left: 8px; display: grid; place-items: center; width: 13px; height: 13px; min-height: 0; padding: 0; color: #222; background: radial-gradient(circle at 50% 35%, #eee, #9a9a9a); border: 0; border-radius: 50%; box-shadow: none; font: 700 11px/1 var(--font-ui); cursor: pointer; }
  .stage { position: relative; display: grid; place-items: center; height: 150px; margin: 14px 16px 8px; background: rgba(0, 0, 0, .35); border: 1px solid rgba(255, 255, 255, .08); border-radius: 8px; box-shadow: inset 0 2px 8px rgba(0, 0, 0, .4); }
  .tick { position: absolute; left: 50%; width: 2px; height: 14px; background: rgba(255, 255, 255, .35); }
  .tick.top { top: 24px; }
  .tick.bottom { bottom: 24px; }
  .word { display: grid; grid-template-columns: 1fr auto 1fr; width: 100%; margin: 0; font: 400 clamp(1.8rem, 7vw, 2.6rem)/1 var(--font-serif); letter-spacing: .01em; white-space: pre; }
  .pre { text-align: right; overflow: hidden; }
  .pivot { color: #ff5a4f; font-weight: 700; }
  .post { text-align: left; overflow: hidden; }
  .scrub { width: calc(100% - 32px); margin: 4px 16px 6px; accent-color: #4596ec; }
  .hud-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding: 0 16px; font-size: .75rem; }
  .hud-controls button { min-width: 34px; color: #f2f2f2; background: linear-gradient(rgba(255, 255, 255, .18), rgba(255, 255, 255, .06)); border: 1px solid rgba(255, 255, 255, .22); box-shadow: none; }
  .hud-controls .play { min-width: 44px; }
  .wpm { display: inline-flex; align-items: center; gap: 6px; color: #d8d8d8; font-size: .6875rem; }
  .wpm input { width: 110px; accent-color: #4596ec; }
  .wpm output { min-width: 26px; text-align: right; font-variant-numeric: tabular-nums; }
  .left { margin-left: auto; color: #aaa; font-size: .6875rem; font-variant-numeric: tabular-nums; }
  .hint { margin: 10px 16px 0; color: #8d8d8d; font-size: .625rem; text-align: center; }
  @media (hover: none) { .hint { display: none; } }
</style>
