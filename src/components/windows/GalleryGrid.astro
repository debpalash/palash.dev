---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'gallery'>[];
}

const { items } = Astro.props;
---

<div class="gallery-grid">
  {items.map((item) => (
    <button
      class="gallery-item"
      data-view={item.data.src}
      data-cap={item.data.caption}
      aria-label={`View ${item.data.title}`}
    >
      <Image
        src={item.data.src}
        alt={item.data.title}
        width={360}
        height={225}
        layout="constrained"
      />
      <span class="cap">{item.data.caption}</span>
    </button>
  ))}
</div>
