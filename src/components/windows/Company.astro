---
import { SITE } from '../../site.config';

const { company } = SITE;
---

<pre class="dim" aria-hidden="true">
┬ ┬┬ ┬┌─┐┌─┐┬ ┬┌─┐
└┬┘│ │├─┘│  ├─┤├─┤
 ┴ └─┘┴  └─┘┴ ┴┴ ┴</pre>

<h2 class="mt-2" style="color:var(--foreground0);text-shadow:var(--glow);">{company.name}</h2>
<p class="cyan">{company.tagline}</p>

<p class="mt-3">{company.blurb}</p>

<p class="mt-4 dim">shipping:</p>

{company.products.map((p) => (
  'open' in p && p.open ? (
    <button class="filerow" data-open={p.open}>
      <span class="fname">{p.name}</span>
      <span class="fmeta">{p.desc}</span>
    </button>
  ) : (
    <a class="filerow" href={'url' in p ? p.url : '#'} target="_blank" rel="noopener">
      <span class="fname">{p.name} ↗</span>
      <span class="fmeta">{p.desc}</span>
    </a>
  )
))}

<p class="mt-4">
  <a is-="button" href={company.url} target="_blank" rel="noopener">[ VISIT {company.name} ↗ ]</a>
</p>
