---
import { SITE } from '../../site.config';
---

<p><span class="dim">$</span> ./contact.sh</p>
<p class="dim">establishing uplink... <span class="boot-ok amber">OK</span></p>

<ul class="mt-3 contact-list">
  {SITE.links.map((l) => (
    <li>
      <span class="dim">──▶</span>
      <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
        {l.label}
      </a>
    </li>
  ))}
</ul>

<p class="mt-4 dim">
  fastest channel: open an issue on any repo, or DM via GitHub profile links.
</p>

<div class="mini-term"></div>

<style>
  .contact-list {
    list-style: none;
    padding: 0;
  }
  .contact-list li {
    padding: 0.2rem 0;
  }
</style>
