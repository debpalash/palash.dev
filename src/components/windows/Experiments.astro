---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'experiments'>[];
}

const { items } = Astro.props;
---

<p class="dim mb-2">/experiments — half-finished by design. some escape and become programs.</p>

{items.map((x) => (
  <a class="filerow" href={x.data.url} target="_blank" rel="noopener">
    <span class="fname">{x.data.name} ↗</span>
    <span class="amber">[{x.data.lang}]</span>
    <span class="fmeta">{x.data.description}</span>
  </a>
))}
