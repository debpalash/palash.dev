---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<p class="dim mb-2">total {posts.length} — writing on engineering & shipping · opens as manuscript</p>

{posts.map((post) => (
  <button class="filerow" data-open={`doc-${post.id}`}>
    <span class="fname">{post.id}.md</span>
    <span class="fmeta">{post.data.publishDate.toISOString().split('T')[0]}</span>
    <span class="fmeta">{post.data.description}</span>
  </button>
))}

<p class="mt-4 dim">
  the log: <a href="/blog">/blog</a> — new writing, often · subscribe: <a href="/rss.xml">rss.xml</a>
</p>
