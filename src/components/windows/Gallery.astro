---
import type { CollectionEntry } from 'astro:content';

interface Props {
  groups: { group: string; label: string; items: CollectionEntry<'gallery'>[] }[];
}

const { groups } = Astro.props;
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<p class="dim mb-2">total {total} captures in {groups.length} folders</p>

{groups.map(({ group, label, items }) => (
  <button class="filerow" data-open={`gal-${group}`}>
    <span aria-hidden="true">▦</span>
    <span class="fname">{group}/</span>
    <span class="fmeta">{items.length} items</span>
    <span class="fmeta">{label}</span>
  </button>
))}

<p class="mt-4 dim">click a folder to browse — images load from GitHub</p>
