---
interface Props {
  name: string;
  tagline: string;
  description: string;
  url?: string;
  icon: string;
  status: 'live' | 'beta' | 'coming-soon';
  stack: string[];
}

const { name, tagline, url, icon, status, stack } = Astro.props;
---

<div id={`product-card-${name.toLowerCase().replace(/\s+/g, '-')}`}>
  <span role="img" aria-label={name}>{icon}</span>
  <h3>{url ? <a href={url} target="_blank" rel="noopener noreferrer">{name}</a> : name}</h3>
  <p>{tagline}</p>
  <div>
    {stack.map((tech) => (
      <span>{tech}</span>
    ))}
  </div>
</div>
