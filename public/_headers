# Hashed build artifacts never change — cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Long-lived static media (referenced by stable paths, replaced rarely).
/og/*
  Cache-Control: public, max-age=86400
/projects/*
  Cache-Control: public, max-age=86400
/gallery/*
  Cache-Control: public, max-age=86400
